---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CourseJourney } from '../components/course/CourseJourney';
import { course } from '../data/course';
---

<BaseLayout
  title="Kurzy | New Level Church"
  description={course.description}
  currentPage="kurzy"
>
  <section class="course-surface">
    <CourseJourney client:load />
  </section>

  <style is:global>
    .course-surface {
      background:
        radial-gradient(circle at 76% 26%, rgba(62, 187, 192, 0.16), transparent 28rem),
        radial-gradient(circle at 12% 36%, rgba(221, 14, 24, 0.16), transparent 24rem),
        linear-gradient(135deg, #111820 0%, #0a1016 46%, #111820 100%);
      color: #ffffff;
      min-height: calc(100svh - 5rem);
      overflow: hidden;
    }

    .course-board {
      position: relative;
      min-height: calc(100svh - 5rem);
      max-width: 104rem;
      margin: 0 auto;
      padding: clamp(2.2rem, 3vw, 4rem) clamp(1.25rem, 3vw, 4rem) 3.8rem;
      isolation: isolate;
    }

    .course-board::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 4.5rem 4.5rem;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95), transparent 86%);
    }

    .course-board::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: radial-gradient(circle at center, transparent 0 42%, rgba(0, 0, 0, 0.32) 78%);
      pointer-events: none;
    }

    .course-board__intro {
      position: absolute;
      left: clamp(1.5rem, 3.4vw, 4.6rem);
      top: clamp(2rem, 4vw, 4.5rem);
      z-index: 5;
      max-width: 25rem;
    }

    .course-board__intro h1 {
      font-family: "Barlow Condensed", "Inter", sans-serif;
      font-size: clamp(3.35rem, 4.75vw, 5.8rem);
      font-weight: 900;
      line-height: 0.93;
      letter-spacing: 0;
      text-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .course-board__intro span {
      display: block;
      color: var(--color-primary);
    }

    .course-board__scripture {
      position: relative;
      margin-top: 1.1rem;
      max-width: 26rem;
      border-left: 0.2rem solid color-mix(in srgb, var(--color-primary) 82%, white);
      padding-left: 1rem;
    }

    .course-board__scripture p {
      margin: 0;
      color: rgba(255, 255, 255, 0.78);
      font-family: "SFMono-Regular", "Roboto Mono", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, monospace;
      font-size: clamp(0.82rem, 0.9vw, 0.96rem);
      font-weight: 700;
      line-height: 1.65;
    }

    .course-board__scripture p::before {
      content: "“";
      color: var(--color-primary);
      font-size: 1.2em;
      font-weight: 900;
    }

    .course-board__scripture p::after {
      content: "”";
      color: var(--color-primary);
      font-size: 1.2em;
      font-weight: 900;
    }

    .course-board__scripture cite {
      display: block;
      margin-top: 0.55rem;
      color: rgba(255, 255, 255, 0.58);
      font-family: "SFMono-Regular", "Roboto Mono", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, monospace;
      font-size: 0.82rem;
      font-style: normal;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .course-board__progress-panel {
      position: absolute;
      right: clamp(1.6rem, 3.4vw, 4.6rem);
      top: clamp(1.75rem, 2.8vw, 3.2rem);
      z-index: 24;
      width: min(20.5rem, 28vw);
      padding: 0.9rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 1rem;
      background: rgba(7, 12, 17, 0.72);
      box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.34);
      backdrop-filter: blur(16px);
    }

    .course-board__progress-panel > span {
      display: block;
      color: rgba(255, 255, 255, 0.58);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .course-board__progress-panel strong {
      display: block;
      margin-top: 0.25rem;
      color: #ffffff;
      font-family: "Barlow Condensed", "Inter", sans-serif;
      font-size: clamp(2rem, 2.7vw, 2.95rem);
      font-weight: 900;
      line-height: 0.9;
    }

    .course-board__progress-bar {
      position: relative;
      height: 0.55rem;
      margin-top: 0.75rem;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
    }

    .course-board__progress-bar i {
      display: block;
      height: 100%;
      min-width: 0.55rem;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
      box-shadow: 0 0 1rem rgba(62, 187, 192, 0.45);
      transition: width 240ms ease;
    }

    .course-board__progress-panel p {
      margin-top: 0.72rem;
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.88rem;
      font-weight: 800;
      line-height: 1.25;
    }

    .course-board__track {
      position: absolute;
      inset: clamp(9rem, 12vh, 10.7rem) clamp(4.2rem, 5.6vw, 6.2rem) clamp(5rem, 6.2vh, 5.8rem) clamp(5.6rem, 8.6vw, 9.6rem);
      z-index: 1;
    }

    .course-board__track svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .course-board__road-shadow,
    .course-board__road-base,
    .course-board__road-border,
    .course-board__road-inner,
    .course-board__segment,
    .course-board__road-line {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
    }

    .course-board__road-shadow {
      stroke: rgba(0, 0, 0, 0.55);
      stroke-width: 98;
      filter: url(#course-road-shadow);
    }

    .course-board__road-base {
      stroke: rgba(11, 14, 17, 0.94);
      stroke-width: 88;
    }

    .course-board__road-border {
      stroke: rgba(255, 255, 255, 0.34);
      stroke-width: 94;
    }

    .course-board__road-inner {
      stroke: rgba(12, 15, 18, 0.96);
      stroke-width: 78;
    }

    .course-board__segment {
      stroke-width: 70;
    }

    .course-board__segment--red {
      stroke: url(#course-locked);
    }

    .course-board__segment--teal {
      stroke: url(#course-locked);
    }

    .course-board__segment--locked {
      stroke: url(#course-locked);
    }

    .course-board--done-0 .course-board__segment--red,
    .course-board--done-1 .course-board__segment--teal,
    .course-board--done-2 .course-board__segment--teal,
    .course-board--done-3 .course-board__segment--locked,
    .course-board--done-4 .course-board__segment--locked,
    .course-board--done-5 .course-board__segment--locked {
      stroke: url(#course-red);
    }

    .course-board--done-1 .course-board__segment--red,
    .course-board--done-2 .course-board__segment--red,
    .course-board--done-3 .course-board__segment--red,
    .course-board--done-3 .course-board__segment--teal,
    .course-board--done-4 .course-board__segment--red,
    .course-board--done-4 .course-board__segment--teal,
    .course-board--done-5 .course-board__segment--red,
    .course-board--done-5 .course-board__segment--teal,
    .course-board--done-6 .course-board__segment--red,
    .course-board--done-6 .course-board__segment--teal,
    .course-board--done-6 .course-board__segment--locked {
      stroke: url(#course-teal);
    }

    .course-board__road-line {
      stroke: rgba(255, 255, 255, 0.72);
      stroke-width: 1.85;
      stroke-dasharray: 240 18;
      opacity: 0.62;
    }

    .course-board__label {
      position: absolute;
      z-index: 3;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      color: rgba(255, 255, 255, 0.78);
      font-family: "Barlow Condensed", "Inter", sans-serif;
      font-size: clamp(0.92rem, 1.15vw, 1.34rem);
      font-weight: 900;
      letter-spacing: 0.04em;
      line-height: 0.95;
      text-align: center;
      text-transform: uppercase;
      text-shadow: 0 3px 10px rgba(0, 0, 0, 0.55);
      pointer-events: none;
    }

    .course-board__label svg {
      width: 1.28rem;
      height: 1.28rem;
      opacity: 0.55;
      stroke-width: 1.7;
    }

    .course-board__label--intro {
      left: 30%;
      top: 36%;
      transform: rotate(-6deg);
    }

    .course-board__label--god {
      left: 15.2%;
      top: 50.2%;
      transform: rotate(-12deg);
      color: rgba(255, 255, 255, 0.54);
    }

    .course-board__label--bible {
      left: 52%;
      top: 30%;
      transform: rotate(-16deg);
    }

    .course-board__label--inspire {
      left: 65.2%;
      top: 17.2%;
      transform: rotate(-3deg);
    }

    .course-board__label--prayer {
      left: 77.5%;
      top: 19%;
      transform: rotate(12deg);
    }

    .course-board__label--community {
      left: 75%;
      top: 62.5%;
      transform: rotate(-18deg);
    }

    .course-board__label--life {
      left: 64%;
      top: 68%;
      transform: rotate(0deg);
    }

    .course-board__label--mission {
      left: 40.5%;
      top: 74.5%;
      transform: rotate(-10deg);
    }

    .course-board__label--world {
      left: 7.2%;
      top: 79%;
      transform: rotate(-4deg);
    }

    .course-board__card {
      position: absolute;
      z-index: 18;
      display: block;
      width: min(17.5rem, 20vw);
      min-width: 13.75rem;
      padding: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.82);
      border-radius: 1.15rem;
      background: rgba(255, 255, 255, 0.96);
      color: #141414;
      box-shadow: 0 1.3rem 2.4rem rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(18px);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease;
    }

    .course-board__card:hover,
    .course-board__card:focus-visible {
      transform: translateY(-0.3rem);
      border-color: rgba(255, 255, 255, 1);
      box-shadow: 0 1.75rem 3rem rgba(0, 0, 0, 0.38);
      outline: none;
    }

    .course-board__card::after {
      content: "";
      position: absolute;
      width: 1.7rem;
      height: 1.7rem;
      background: rgba(255, 255, 255, 0.96);
      border-right: 1px solid rgba(255, 255, 255, 0.85);
      border-bottom: 1px solid rgba(255, 255, 255, 0.85);
      transform: rotate(45deg);
    }

    .course-board__card--one {
      left: 6%;
      top: 33%;
    }

    .course-board__card--one::after {
      left: -0.85rem;
      top: 64%;
    }

    .course-board__card--two {
      left: 36%;
      top: 1.8rem;
      width: min(18.5rem, 21vw);
    }

    .course-board__card--two::after {
      left: 43%;
      bottom: -0.85rem;
    }

    .course-board__card--three {
      right: 2.3%;
      top: 34%;
      width: min(17.5rem, 20vw);
    }

    .course-board__card--three::after {
      left: -0.85rem;
      top: 43%;
    }

    .course-board__card--four {
      left: 46%;
      top: 56%;
      width: min(17rem, 20vw);
    }

    .course-board__card--four::after {
      left: 48%;
      top: -0.85rem;
      border: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.85);
      border-top: 1px solid rgba(255, 255, 255, 0.85);
    }

    .course-board__card--five {
      left: 15%;
      top: 65%;
      width: min(17rem, 20vw);
    }

    .course-board__card--five::after {
      left: 40%;
      top: -0.85rem;
      border: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.85);
      border-top: 1px solid rgba(255, 255, 255, 0.85);
    }

    .course-board__card--six {
      left: 2.5%;
      top: 68%;
      width: min(17rem, 20vw);
    }

    .course-board__card--six::after {
      left: 30%;
      top: -0.85rem;
      border: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.85);
      border-top: 1px solid rgba(255, 255, 255, 0.85);
    }


    .course-board__mini {
      display: inline-flex;
      width: 2.55rem;
      height: 2.55rem;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem;
      border-radius: 999px;
      color: #ffffff;
      box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.18);
    }

    .course-board__mini svg {
      width: 1.55rem;
      height: 1.55rem;
      fill: currentColor;
      stroke-width: 2.4;
    }

    .course-board__mini--red {
      background: var(--color-primary);
    }

    .course-board__mini--teal {
      background: var(--color-accent);
    }

    .course-board__mini--dark {
      background: #8a8a8a;
    }

    .course-board__state {
      display: inline-flex;
      width: max-content;
      margin-bottom: 0.55rem;
      padding: 0.24rem 0.55rem;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      line-height: 1;
      text-transform: uppercase;
    }

    .course-board__state--red {
      background: rgba(221, 14, 24, 0.1);
      color: var(--color-primary);
    }

    .course-board__state--teal {
      background: rgba(62, 187, 192, 0.13);
      color: #168b94;
    }

    .course-board__state--dark {
      background: rgba(0, 0, 0, 0.08);
      color: #626262;
    }

    .course-board__card h2 {
      font-size: clamp(1.08rem, 1.25vw, 1.35rem);
      font-weight: 900;
      line-height: 1.08;
      letter-spacing: 0;
    }

    .course-board__card p {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 0.8rem;
      color: #454545;
      font-size: clamp(0.84rem, 0.85vw, 0.96rem);
      font-weight: 600;
      line-height: 1.48;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .course-board__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.85rem;
    }

    .course-board__pill {
      display: inline-flex;
      align-items: center;
      gap: 0.32rem;
      min-height: 1.85rem;
      padding: 0.3rem 0.58rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.6);
      font-size: 0.78rem;
      font-weight: 900;
      line-height: 1;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.035);
    }

    .course-board__pill svg {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      stroke-width: 2.4;
    }

    .course-board__pill--red {
      color: var(--color-primary);
      background: rgba(221, 14, 24, 0.06);
    }

    .course-board__pill--teal {
      color: #1c9199;
      background: rgba(62, 187, 192, 0.08);
    }

    .course-board__pill--dark {
      color: #5b5b5b;
      background: rgba(0, 0, 0, 0.05);
    }

    .course-board__pill--disabled {
      opacity: 0.42;
    }

    .course-board__detail {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 4.55rem;
      min-height: 2rem;
      margin-top: 0.82rem;
      border-radius: 0.65rem;
      color: #ffffff;
      font-size: 0.9rem;
      font-weight: 900;
    }

    .course-board__detail--red {
      background: var(--color-primary);
    }

    .course-board__detail--teal {
      background: #178f98;
    }

    .course-board__detail--dark {
      background: #333;
    }

    .course-board__detail[aria-disabled="true"] {
      pointer-events: none;
      opacity: 0.52;
    }

    .course-board__node {
      position: absolute;
      z-index: 8;
      display: flex;
      width: clamp(4.85rem, 5.45vw, 6.1rem);
      height: clamp(4.85rem, 5.45vw, 6.1rem);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      border: 0.28rem solid rgba(255, 255, 255, 0.9);
      border-radius: 999px;
      color: #ffffff;
      cursor: pointer;
      box-shadow:
        0 1rem 1.8rem rgba(0, 0, 0, 0.38),
        inset 0 0 0 0.18rem rgba(255, 255, 255, 0.16);
      transition:
        transform 180ms ease,
        box-shadow 180ms ease;
    }

    .course-board__node:hover,
    .course-board__node:focus-visible {
      transform: scale(1.06);
      outline: none;
      box-shadow:
        0 1.3rem 2.2rem rgba(0, 0, 0, 0.46),
        0 0 0 0.35rem rgba(255, 255, 255, 0.15),
        inset 0 0 0 0.18rem rgba(255, 255, 255, 0.16);
    }

    .course-board__tooltip {
      position: absolute;
      left: 50%;
      bottom: calc(100% + 0.9rem);
      width: max-content;
      max-width: 14rem;
      transform: translateX(-50%) translateY(0.35rem);
      border: 1px solid rgba(255, 255, 255, 0.82);
      border-radius: 0.85rem;
      background: rgba(255, 255, 255, 0.96);
      color: #151515;
      padding: 0.65rem 0.8rem;
      font-family: "Inter", sans-serif;
      font-size: 0.86rem;
      font-weight: 900;
      line-height: 1.15;
      opacity: 0;
      pointer-events: none;
      text-align: left;
      box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.28);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .course-board__tooltip::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -0.45rem;
      width: 0.9rem;
      height: 0.9rem;
      background: rgba(255, 255, 255, 0.96);
      transform: translateX(-50%) rotate(45deg);
    }

    .course-board__tooltip small {
      display: block;
      margin-top: 0.25rem;
      color: var(--color-primary);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .course-board__node:hover .course-board__tooltip,
    .course-board__node:focus-visible .course-board__tooltip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .course-board__hint {
      position: absolute;
      left: 50%;
      bottom: 1.35rem;
      z-index: 20;
      transform: translateX(-50%);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.5rem 0.9rem;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.82rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      backdrop-filter: blur(12px);
    }

    .course-board__mobile-list {
      display: none;
    }

    .course-board__node strong {
      font-family: "Barlow Condensed", "Inter", sans-serif;
      font-size: clamp(2rem, 2.65vw, 3rem);
      font-weight: 900;
      line-height: 0.85;
      letter-spacing: 0;
    }

    .course-board__node svg {
      width: 1.05rem;
      height: 1.05rem;
      margin-top: 0.28rem;
      stroke-width: 2.7;
    }

    .course-board__node--done {
      background: #188f98;
      border-color: rgba(255, 255, 255, 0.96);
      box-shadow:
        0 1rem 1.8rem rgba(0, 0, 0, 0.38),
        0 0 0 0.42rem rgba(62, 187, 192, 0.2),
        inset 0 0 0 0.18rem rgba(255, 255, 255, 0.16);
    }

    .course-board__node--current {
      background: var(--color-primary);
      animation: course-current-pulse 1.8s ease-in-out infinite;
    }

    .course-board__node--locked {
      background: #2c2f32;
      color: rgba(255, 255, 255, 0.92);
      cursor: not-allowed;
      filter: saturate(0.7);
    }

    .course-board__node--locked:hover,
    .course-board__node--locked:focus-visible {
      transform: none;
    }

    @keyframes course-current-pulse {
      0%,
      100% {
        box-shadow:
          0 1rem 1.8rem rgba(0, 0, 0, 0.38),
          0 0 0 0 rgba(221, 14, 24, 0.34),
          inset 0 0 0 0.18rem rgba(255, 255, 255, 0.16);
      }

      50% {
        box-shadow:
          0 1rem 1.8rem rgba(0, 0, 0, 0.38),
          0 0 0 0.6rem rgba(221, 14, 24, 0),
          inset 0 0 0 0.18rem rgba(255, 255, 255, 0.16);
      }
    }

    .course-board__node--one {
      left: 15.2%;
      top: 50.5%;
    }

    .course-board__node--two {
      left: 44.3%;
      top: 43.4%;
    }

    .course-board__node--three {
      right: 12.9%;
      top: 50%;
    }

    .course-board__node--four {
      right: 25.4%;
      bottom: 18.6%;
    }

    .course-board__node--five {
      left: 32%;
      bottom: 19.3%;
    }

    .course-board__node--six {
      left: 11.3%;
      bottom: 12.4%;
    }

    .course-board__legend {
      position: absolute;
      right: clamp(1.25rem, 3vw, 4rem);
      bottom: 1.35rem;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.95rem;
      font-weight: 800;
    }

    .course-board__legend span {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      white-space: nowrap;
    }

    .course-board__legend svg {
      width: 1.05rem;
      height: 1.05rem;
      color: rgba(255, 255, 255, 0.55);
    }

    .course-board__dot {
      display: inline-block;
      width: 0.95rem;
      height: 0.95rem;
