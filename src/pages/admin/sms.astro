---
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>SMS Admin | New Level Church</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #0b0c0f;
        color: #f7f7f2;
      }

      * { box-sizing: border-box; }
      body { margin: 0; background: #0b0c0f; }
      .app { width: min(1120px, calc(100vw - 32px)); margin: 0 auto; padding: 28px 0 56px; }
      .topbar, .section-head, .actions, .status, .schedule-toggle { display: flex; align-items: center; gap: 12px; }
      .topbar, .section-head { justify-content: space-between; }
      .eyebrow, .hint, summary { color: #a9abb3; }
      h1, h2, p { margin: 0; }
      h1 { font-size: clamp(32px, 5vw, 52px); line-height: .95; }
      h2 { font-size: 18px; }
      .panel { margin-top: 18px; padding: 18px; border: 1px solid #2b2f38; border-radius: 8px; background: #14161b; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
      .login-grid { grid-template-columns: 1fr auto; align-items: end; }
      label { display: grid; gap: 6px; color: #d7d9df; font-size: 13px; font-weight: 700; }
      input, select, textarea, button { border: 1px solid #363b46; border-radius: 6px; background: #0d0f14; color: #f7f7f2; font: inherit; }
      input, select, textarea { width: 100%; padding: 10px 11px; }
      textarea { min-height: 150px; resize: vertical; margin-top: 12px; }
      button { padding: 10px 12px; cursor: pointer; font-weight: 800; }
      button:hover { border-color: #7dd3fc; }
      details.panel { padding: 0; }
      details.panel > summary { cursor: pointer; padding: 16px 18px; color: #d7d9df; font-size: 14px; font-weight: 800; }
      .access-content { padding: 0 18px 18px; }
      .actions { margin-top: 14px; flex-wrap: wrap; }
      .badge { min-width: 96px; padding: 8px 10px; border-radius: 999px; background: #3f2d06; color: #facc15; text-align: center; font-size: 12px; font-weight: 900; }
      .badge.is-live { background: #063b2f; color: #34d399; }
      .table-wrap { max-height: 360px; overflow: auto; margin-top: 14px; border: 1px solid #252a33; border-radius: 6px; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      th, td { padding: 10px; border-bottom: 1px solid #252a33; text-align: left; white-space: nowrap; }
      th { position: sticky; top: 0; background: #171a20; z-index: 1; }
      tr.is-muted { color: #747985; }
      .message-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; }
      .preview { min-height: 58px; margin-top: 12px; padding: 12px; border-radius: 6px; background: #0d0f14; color: #d7d9df; white-space: pre-wrap; }
      .result { color: #7dd3fc; font-weight: 800; }
      .result.is-error { color: #f87171; }
      .schedule-toggle { display: inline-flex; margin-top: 14px; cursor: pointer; }
      .schedule-toggle input, td input { width: 18px; height: 18px; margin: 0; accent-color: #38bdf8; }
      .schedule-fields[hidden] { display: none; }
      .primary { border-color: #38bdf8; background: #0c4a6e; }

      @media (max-width: 820px) {
        .grid, .login-grid { grid-template-columns: 1fr; }
        .topbar, .section-head { align-items: flex-start; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <header class="topbar">
        <div>
          <p class="eyebrow">New Level Admin</p>
          <h1>SMS kampane</h1>
        </div>
        <div class="status">
          <span class="badge" data-test-mode>TEST MODE?</span>
          <button type="button" data-refresh>Obnoviť</button>
        </div>
      </header>

      <details class="panel" data-access>
        <summary>Admin prístup <span class="hint" data-access-status></span></summary>
        <div class="access-content">
          <div class="grid login-grid">
            <label>Admin API kľúč<input data-admin-key type="password" autocomplete="current-password" /></label>
            <button type="button" data-save-key>Použiť kľúč</button>
          </div>
          <div class="actions">
            <button type="button" data-clear-key>Vymazať kľúč</button>
          </div>
          <input data-supabase-url type="hidden" />
        </div>
      </details>

      <section class="panel">
        <div class="section-head">
          <h2>Aktívne kampane</h2>
          <button type="button" data-load-campaigns>Obnoviť kampane</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Odoslanie</th><th>Publikum</th><th>Sender</th><th>Správa</th><th>Stav</th><th></th></tr>
            </thead>
            <tbody data-campaigns></tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <div class="section-head">
          <h2>1. Vyber čísla</h2>
          <span data-counts>0 vybraných</span>
        </div>
        <div class="grid">
          <label>Dátum mládeže<input data-event-date type="date" /></label>
          <label>Komu poslať
            <select data-audience>
              <option value="registered_for_event">Prihláseným na tento dátum</option>
              <option value="previously_registered_not_registered">Boli už niekedy, ale teraz nie sú prihlásení</option>
              <option value="all_with_phone">Všetkým s telefónom</option>
            </select>
          </label>
        </div>
        <div class="actions">
          <button type="button" data-select-filtered>Vybrať všetkých</button>
          <button type="button" data-deselect>Zrušiť výber</button>
          <button type="button" data-load-audience>Obnoviť zoznam</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th></th><th>Meno</th><th>Telefón</th><th>Stav</th></tr>
            </thead>
            <tbody data-contacts></tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <div class="section-head">
          <h2>2. Napíš SMS</h2>
          <span data-segments>0 znakov</span>
        </div>
        <label>Meno odosielateľa<input data-sender maxlength="11" placeholder="NewLevel" /></label>
        <p class="hint">Max 11 písmen alebo čísiel, bez medzier. Infobip musí tento sender povoliť.</p>
        <label>Text SMS<textarea data-message rows="7" placeholder="Ahoj &#123;&#123;first_name&#125;&#125;, vidíme sa na New Level Youth?"></textarea></label>
        <p class="hint">Môžeš použiť: &#123;&#123;first_name&#125;&#125;, &#123;&#123;name&#125;&#125;, &#123;&#123;event_date&#125;&#125;, &#123;&#123;registration_url&#125;&#125;</p>
        <div class="preview" data-preview>Preview sa zobrazí po napísaní SMS.</div>
      </section>

      <section class="panel">
        <div class="section-head">
          <h2>3. Odošli SMS</h2>
          <span class="result" data-result></span>
        </div>
        <label class="schedule-toggle">
          <input type="checkbox" data-schedule-toggle />
          Naplánovať odoslanie
        </label>
        <div class="grid schedule-fields" data-schedule-fields hidden>
          <label>Dátum odoslania<input data-date type="date" /></label>
          <label>Čas odoslania<input data-time type="time" /></label>
        </div>
        <div class="actions">
          <button class="primary" type="button" data-submit>Poslať teraz</button>
        </div>
      </section>
    </main>

    <script>
      const DEFAULT_SUPABASE_URL = "https://kbpuhcuiljbwgxgiauku.supabase.co";
      const state = {
        adminKey: "",
        contacts: [],
        selected: new Set(),
        event: null,
        campaigns: [],
        editingCampaignId: null,
      };
      const $ = (selector) => document.querySelector(selector);
      const endpoint = () => `${$("[data-supabase-url]").value.trim().replace(/\/+$/, "")}/functions/v1/admin-sms`;

      function setResult(message, isError = false) {
        const result = $("[data-result]");
        result.textContent = message;
        result.classList.toggle("is-error", isError);
      }

      function showError(error) {
        const message = error instanceof Error ? error.message : String(error);
        setResult(message, true);
        alert(message);
      }

      function saveConfig() {
        localStorage.setItem("smsAdminUrl", $("[data-supabase-url]").value.trim());
        localStorage.setItem("smsAdminKey", $("[data-admin-key]").value.trim());
        localStorage.setItem("smsSender", $("[data-sender]").value.trim());
        state.adminKey = $("[data-admin-key]").value.trim();
      }

      function loadConfig() {
        $("[data-supabase-url]").value = localStorage.getItem("smsAdminUrl") || DEFAULT_SUPABASE_URL;
        state.adminKey = localStorage.getItem("smsAdminKey") || "";
        $("[data-admin-key]").value = state.adminKey;
        $("[data-sender]").value = localStorage.getItem("smsSender") || "NewLevel";
      }

      async function api(body) {
        if (!state.adminKey) throw new Error("Najprv zadaj admin API kľúč.");
        const response = await fetch(endpoint(), {
          method: "POST",
          headers: { "x-admin-sms-key": state.adminKey, "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await response.json().catch(() => ({ error: "Server vrátil nečitateľnú odpoveď" }));
        if (!response.ok || !data.success) {
          const detail = data.errorMessage || data.errorCode || data.error || `Request failed (${response.status})`;
          throw new Error(detail);
        }
        return data;
      }

      function localScheduledIso() {
        const date = $("[data-date]").value;
        const time = $("[data-time]").value;
        if (!date || !time) return null;
        return new Date(`${date}T${time}:00`).toISOString();
      }

      function setLocalDateTime(iso) {
        const date = new Date(iso);
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        $("[data-date]").value = local.toISOString().slice(0, 10);
        $("[data-time]").value = local.toISOString().slice(11, 16);
      }

      function localDateTimeLabel(iso) {
        return new Intl.DateTimeFormat("sk-SK", {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(iso));
      }

      function audienceLabel(value) {
        return {
          registered_for_event: "Prihlásení",
          previously_registered_not_registered: "Boli, teraz nie",
          not_registered_for_event: "Neprihlásení",
          all_with_phone: "Všetci s telefónom",
        }[value] || value;
      }

      function eventFromCampaign(campaign) {
        return Array.isArray(campaign.event) ? campaign.event[0] : campaign.event;
      }

      function updateCounts() {
        const visible = state.contacts.filter((contact) => contact.matches);
        $("[data-counts]").textContent = `${state.selected.size} vybraných / ${visible.length} v zozname`;
      }

      function contactStatus(contact) {
        if (!contact.normalizedPhone) return "neplatné číslo";
        if (!contact.sms_enabled) return "SMS vypnuté";
        if (contact.testModeBlocked) return "v test režime nepovolené";
        return "pripravené";
      }

      function renderContacts() {
        const tbody = $("[data-contacts]");
        tbody.innerHTML = "";
        const visibleContacts = state.contacts.filter((contact) => contact.matches);
        for (const contact of visibleContacts) {
          const row = document.createElement("tr");
          if (!contact.eligible) row.classList.add("is-muted");
          row.innerHTML = `
            <td><input type="checkbox" data-contact-id="${contact.id}"></td>
            <td>${contact.name || ""}</td>
            <td>${contact.normalizedPhone || contact.phone || ""}</td>
            <td>${contactStatus(contact)}</td>
          `;
          const checkbox = row.querySelector("input");
          checkbox.checked = state.selected.has(contact.id);
          checkbox.disabled = !contact.eligible;
          checkbox.addEventListener("change", () => {
            if (checkbox.checked) state.selected.add(contact.id);
            else state.selected.delete(contact.id);
            updateCounts();
          });
          tbody.append(row);
        }
        updateCounts();
        updateSegmentPreview();
      }

      async function refreshConfig() {
        const config = await api({ action: "config" });
        const badge = $("[data-test-mode]");
        badge.textContent = config.testMode ? `TEST MODE (${config.allowedCount})` : "LIVE SMS";
        badge.classList.toggle("is-live", !config.testMode);
        if (!localStorage.getItem("smsSender") && config.sender) $("[data-sender]").value = config.sender;
        $("[data-access-status]").textContent = "pripojené";
      }

      async function saveKey() {
        saveConfig();
        await refreshConfig();
        await loadCampaigns();
        await loadAudience();
        $("[data-access]").open = false;
      }

      function clearKey() {
        localStorage.removeItem("smsAdminKey");
        state.adminKey = "";
        $("[data-admin-key]").value = "";
        $("[data-access-status]").textContent = "";
        $("[data-access]").open = true;
        setResult("Kľúč vymazaný");
      }

      async function loadAudience() {
        const result = await api({
          action: "list_audience",
          eventDate: $("[data-event-date]").value,
          audienceType: $("[data-audience]").value,
        });
        state.event = result.event || null;
        state.contacts = result.contacts || [];
        state.selected.clear();
        renderContacts();
        const visible = state.contacts.filter((contact) => contact.matches);
        const usable = visible.filter((contact) => contact.eligible);
        setResult(`Načítané: ${visible.length} v zozname, ${usable.length} použiteľných`);
      }

      async function loadCampaigns() {
        const result = await api({ action: "list_campaigns" });
        state.campaigns = result.campaigns || [];
        renderCampaigns();
      }

      function renderCampaigns() {
        const tbody = $("[data-campaigns]");
        tbody.innerHTML = "";
        if (!state.campaigns.length) {
          const row = document.createElement("tr");
          row.innerHTML = `<td colspan="6" class="hint">Žiadne aktívne kampane</td>`;
          tbody.append(row);
          return;
        }

        for (const campaign of state.campaigns) {
          const event = eventFromCampaign(campaign);
          const row = document.createElement("tr");
          row.innerHTML = `
            <td>${localDateTimeLabel(campaign.scheduled_for)}</td>
            <td>${audienceLabel(campaign.audience_type)}<br><span class="hint">${event?.event_date || ""}</span></td>
            <td>${campaign.sender || ""}</td>
            <td class="message-cell">${campaign.message || ""}</td>
            <td>${campaign.status} ${campaign.queued_count ? `(${campaign.sent_count}/${campaign.queued_count})` : ""}</td>
            <td>
              <button type="button" data-edit-campaign="${campaign.id}">Upraviť</button>
              <button type="button" data-cancel-campaign="${campaign.id}">Zrušiť</button>
            </td>
          `;
          tbody.append(row);
        }
      }

      async function editCampaign(id) {
        const campaign = state.campaigns.find((item) => item.id === id);
        if (!campaign) return;
        const event = eventFromCampaign(campaign);
        state.editingCampaignId = campaign.id;
        $("[data-event-date]").value = event?.event_date || "";
        $("[data-audience]").value = campaign.audience_type;
        $("[data-sender]").value = campaign.sender || "NewLevel";
        $("[data-message]").value = campaign.message || "";
        $("[data-schedule-toggle]").checked = true;
        setLocalDateTime(campaign.scheduled_for);
        updateSchedule();
        updateSegmentPreview();
        await loadAudience();
        setResult("Upravuješ aktívnu kampaň");
      }

      async function cancelCampaign(id) {
        if (!confirm("Zrušiť túto kampaň?")) return;
        await api({ action: "cancel_campaign", campaignId: id });
        if (state.editingCampaignId === id) state.editingCampaignId = null;
        await loadCampaigns();
        setResult("Kampaň zrušená");
      }

      async function updateCampaign() {
        const sender = $("[data-sender]").value.trim();
        const scheduledFor = localScheduledIso();
        if (!state.editingCampaignId) return;
        if (!/^[A-Za-z0-9]{1,11}$/.test(sender)) throw new Error("Meno odosielateľa musí mať 1-11 písmen alebo čísiel bez medzier.");
        if (!$("[data-message]").value.trim()) throw new Error("Napíš text SMS.");
        if (!scheduledFor) throw new Error("Vyber dátum a čas odoslania.");
        await api({
          action: "update_campaign",
          campaignId: state.editingCampaignId,
          sender,
          message: $("[data-message]").value,
          eventDate: $("[data-event-date]").value,
          audienceType: $("[data-audience]").value,
          scheduledFor,
        });
        state.editingCampaignId = null;
        await loadCampaigns();
        updateSchedule();
        setResult("Kampaň upravená");
      }

      function updateSegmentPreview() {
        const text = $("[data-message]").value;
        const chars = [...text].length;
        const hasUnicode = /[^\x00-\x7F]/.test(text);
        const single = hasUnicode ? 70 : 160;
        const multi = hasUnicode ? 67 : 153;
        const segments = chars <= single ? 1 : Math.ceil(chars / multi);
        $("[data-segments]").textContent = `${chars} znakov, približne ${segments} SMS segment${segments === 1 ? "" : "y"}`;
        const first =
          state.contacts.find((contact) => state.selected.has(contact.id)) ||
          state.contacts.find((contact) => contact.matches) ||
          state.contacts[0];
        const eventDate = state.event?.event_date || $("[data-event-date]").value || "";
        const preview = text
          .replaceAll("{{first_name}}", first?.name?.split(/\s+/)[0] || "Ahoj")
          .replaceAll("{{name}}", first?.name || "")
          .replaceAll("{{email}}", first?.email || "")
          .replaceAll("{{phone}}", first?.normalizedPhone || first?.phone || "")
          .replaceAll("{{event_name}}", "New Level Party")
          .replaceAll("{{event_date}}", eventDate)
          .replaceAll("{{registration_url}}", "https://newlevel.church/youth/");
        $("[data-preview]").textContent = preview || "Preview sa zobrazí po napísaní SMS.";
      }

      async function createCampaign(sendNow) {
        const selected = [...state.selected];
        const sender = $("[data-sender]").value.trim();
        if (state.editingCampaignId) {
          await updateCampaign();
          return;
        }
        if (sendNow && !selected.length) throw new Error("Vyber aspoň jedno telefónne číslo.");
        if (!/^[A-Za-z0-9]{1,11}$/.test(sender)) throw new Error("Meno odosielateľa musí mať 1-11 písmen alebo čísiel bez medzier.");
        if (!$("[data-message]").value.trim()) throw new Error("Napíš text SMS.");
        const scheduledFor = sendNow ? new Date().toISOString() : localScheduledIso();
        if (!sendNow && !scheduledFor) throw new Error("Vyber dátum a čas odoslania.");
        localStorage.setItem("smsSender", sender);
        const audience = $("[data-audience]").value;
        const recipientLine = sendNow
          ? `Príjemcov: ${selected.length}`
          : `Publikum: ${audienceLabel(audience)} sa skontroluje až v čase odoslania`;
        const ok = confirm(`Potvrdiť SMS?\n\nOdosielateľ: ${sender}\n${recipientLine}\nRežim: ${sendNow ? "poslať teraz" : "naplánovať"}\n\n${$("[data-message]").value}`);
        if (!ok) return;
        const result = await api({
          action: "create_campaign",
          name: "New Level SMS",
          sender,
          message: $("[data-message]").value,
          eventDate: $("[data-event-date]").value,
          audienceType: sendNow ? "custom_selection" : audience,
          selectedContactIds: sendNow ? selected : [],
          sendNow,
          scheduledFor,
        });
        if (!sendNow) {
          await loadCampaigns();
          setResult("Kampaň naplánovaná");
          return;
        }

        const deliveries = result.processed?.results || [];
        const sent = deliveries.filter((delivery) => delivery.ok).length;
        const failed = deliveries.find((delivery) => !delivery.ok);
        if (failed) {
          const parts = [
            "SMS sa neodoslala",
            failed.errorCode,
            failed.errorMessage,
            failed.debugDetails ? `Debug: ${failed.debugDetails}` : "",
          ].filter(Boolean);
          throw new Error(parts.join("\n"));
        }
        if (sent !== result.queued) {
          throw new Error("SMS zostala čakať v rade. Skús odoslanie znovu.");
        }
        setResult(`Odoslané: ${sent} SMS`);
      }

      function updateSchedule() {
        const scheduled = $("[data-schedule-toggle]").checked;
        $("[data-schedule-fields]").hidden = !scheduled;
        $("[data-submit]").textContent = scheduled ? "Naplánovať SMS" : "Poslať teraz";
        if (state.editingCampaignId) $("[data-submit]").textContent = "Uložiť zmeny";
      }

      function setDefaultSchedule() {
        const date = new Date(Date.now() + 60 * 60 * 1000);
        date.setMinutes(0, 0, 0);
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        $("[data-date]").value = local.toISOString().slice(0, 10);
        $("[data-time]").value = local.toISOString().slice(11, 16);
      }

      function setDefaultEventDate() {
        const date = new Date();
        const day = date.getDay();
        let daysUntilFriday = (5 - day + 7) % 7;
        if (day === 5 || day === 6) daysUntilFriday = day === 5 ? 7 : 6;
        date.setDate(date.getDate() + daysUntilFriday);
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        $("[data-event-date]").value = local.toISOString().slice(0, 10);
      }

      function bind() {
        $("[data-save-key]").addEventListener("click", () => saveKey().catch(showError));
        $("[data-clear-key]").addEventListener("click", clearKey);
        $("[data-refresh]").addEventListener("click", () => saveKey().catch(showError));
        $("[data-load-audience]").addEventListener("click", () => loadAudience().catch(showError));
        $("[data-load-campaigns]").addEventListener("click", () => loadCampaigns().catch(showError));
        $("[data-campaigns]").addEventListener("click", (event) => {
          const editButton = event.target.closest("[data-edit-campaign]");
          const cancelButton = event.target.closest("[data-cancel-campaign]");
          if (editButton) editCampaign(editButton.dataset.editCampaign).catch(showError);
          if (cancelButton) cancelCampaign(cancelButton.dataset.cancelCampaign).catch(showError);
        });
        $("[data-select-filtered]").addEventListener("click", () => {
          for (const contact of state.contacts) {
            if (contact.matches && contact.eligible) state.selected.add(contact.id);
          }
          renderContacts();
        });
        $("[data-deselect]").addEventListener("click", () => { state.selected.clear(); renderContacts(); });
        $("[data-audience]").addEventListener("change", () => loadAudience().catch(showError));
        $("[data-event-date]").addEventListener("change", () => loadAudience().catch(showError));
        $("[data-message]").addEventListener("input", updateSegmentPreview);
        $("[data-schedule-toggle]").addEventListener("change", updateSchedule);
        $("[data-submit]").addEventListener("click", () => createCampaign(!$("[data-schedule-toggle]").checked).catch(showError));
      }

      loadConfig();
      bind();
      setDefaultEventDate();
      setDefaultSchedule();
      updateSchedule();
      updateSegmentPreview();
      if (state.adminKey) saveKey().catch(showError);
      else $("[data-access]").open = true;
    </script>
  </body>
</html>
