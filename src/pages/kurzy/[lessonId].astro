      cursor: pointer;
      align-items: center;
      gap: 0.7rem;
      border: 1px solid color-mix(in srgb, var(--color-text-muted) 20%, transparent);
      border-radius: 0.85rem;
      background: #ffffff;
      padding: 0.72rem 0.85rem;
      color: var(--color-text-light);
      font-size: 0.96rem;
      font-weight: 750;
      line-height: 1.25;
      transition:
        border-color 160ms ease,
        box-shadow 160ms ease,
        color 160ms ease;
