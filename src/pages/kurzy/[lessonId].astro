    .course-quiz-prompt {
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1rem, 2.8vw, 1.12rem);
      font-weight: 900;
      line-height: 1.28;
      letter-spacing: 0;
    }

    .course-quiz-note {
      margin-top: 0.45rem;
