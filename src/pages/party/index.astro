---
import BaseLayout from '../../layouts/BaseLayout.astro';
import page from '../../content/party/page.json';
import contactInfo from '../../content/settings/contact.json';
import { getPartyPhotos } from '../../utils/gallery';

const partyPhotos = getPartyPhotos();
const heroPhotos = [
  { image: '/images/uploads/party-image00004.jpg', caption: 'New Level Party' },
  { image: '/images/uploads/party-image00001.jpg', caption: 'Spoločné jedlo' },
  { image: '/images/uploads/party-image00005.jpg', caption: 'Party program' },
  { image: '/images/uploads/party-image00006.jpg', caption: 'Party program' },
  { image: '/images/uploads/party-image00007.jpg', caption: 'Kalčeto' },
  { image: '/images/uploads/party-image00009.jpg', caption: 'Ping Pong' },
  { image: '/images/uploads/party-image00010.jpg', caption: 'Ping Pong' },
  { image: '/images/uploads/party-image00011.jpg', caption: 'Kalčeto' },
  { image: '/images/uploads/party-image00014.jpg', caption: 'Herňa' },
  { image: '/images/uploads/party-image00015.jpg', caption: 'Herňa' },
  { image: '/images/uploads/party-image00016.jpg', caption: 'Herňa' },
];
const heroPhoto = heroPhotos[0];
const featurePhoto = partyPhotos[0] || heroPhoto;
const momentPhotos = partyPhotos.slice(0, 3);
const activityPhotos = [
  '/images/uploads/party-image00001.jpg',
  '/images/uploads/party-image00010.jpg',
  '/images/uploads/party-image00011.jpg',
  '/images/uploads/party-image00016.jpg',
  '/images/uploads/party-image00002.jpg',
  '/images/uploads/party-image00006.jpg',
];
const countdownTitleLines = page.countdown.title === 'Registrácia sa uzatvára o'
  ? ['Registrácia', 'sa uzatvára o']
  : [page.countdown.title];
---

<BaseLayout title="Party | New Level Church" description={page.hero.subtitle} currentPage="party">
  <div class="party-page-shell">
    <svg class="poster-filter-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="print-distress">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="9" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <!-- Section 1: Hero Poster -->
    <section class="poster-section hero-poster">
      <div class="poster-noise" aria-hidden="true"></div>
      <div class="poster-wrap hero-grid">
        <div class="hero-copy">
          <h1>
            <span>{page.hero.title}</span>
            <span>{page.hero.titleAccent}</span>
          </h1>
          <span class="hero-badge">{page.hero.badge}</span>
          <div class="hero-secondary">
            <p>{page.hero.subtitle}</p>
            <a href="#registracia" class="poster-button">Registrovať sa na jedlo</a>
          </div>
          <div class="scroll-sticker">
            <span>Scrolluj nižšie</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 9l7 7 7-7"></path>
            </svg>
          </div>
        </div>
        {heroPhoto && (
          <div class="hero-photo-stack">
            <img
              id="party-hero-photo"
              src={heroPhoto.image}
              alt={heroPhoto.caption}
              width="720"
              height="520"
              data-hero-photos={JSON.stringify(heroPhotos)}
            >
          </div>
        )}
      </div>
    </section>

    <!-- Section 2: Quick Info Strip -->
    <section class="poster-section info-strip-section">
      <div class="poster-wrap">
        <div class="quick-strip">
          {page.quickInfo.map((item: { title: string; text: string }, i: number) => (
            <div class="quick-strip-item">
              <span>{`0${i + 1}`}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 3: Weekly Food Menu -->
    <section id="menu" class="poster-section menu-poster-section">
      <div class="poster-wrap menu-layout">
        <div class="poster-heading">
          <h2>{page.menu.title}</h2>
          <p>{page.menu.subtitle}</p>
        </div>
        <div class="menu-ticket">
          <div class="menu-emoji" set:html={page.menu.emoji}></div>
          <div>
            <h3>{page.menu.dish}</h3>
            <p>{page.menu.description}</p>
          </div>
          <a href="#registracia" class="poster-button">Registrovať sa na jedlo</a>
        </div>
      </div>
    </section>

    <!-- Section 3.5: Countdown Timer & Registration Counter -->
    <section class="poster-section countdown-poster-section">
      <div class="poster-wrap countdown-layout">
        <div id="countdown-section" class="countdown-poster">
          <div class="poster-heading poster-heading-invert">
            <h2 aria-label={page.countdown.title}>
              {countdownTitleLines.map((line) => <span aria-hidden="true">{line}</span>)}
            </h2>
          </div>
          <div class="countdown-grid">
            <div>
              <span id="countdown-days" class="countdown-number">--</span>
              <span>dní</span>
            </div>
            <div>
              <span id="countdown-hours" class="countdown-number">--</span>
              <span>hodín</span>
            </div>
            <div>
              <span id="countdown-minutes" class="countdown-number">--</span>
              <span>minút</span>
            </div>
            <div>
              <span id="countdown-seconds" class="countdown-number">--</span>
              <span>sekúnd</span>
            </div>
          </div>
        </div>

        <div id="deadline-passed" class="deadline-poster hidden">
          <h2>Registrácia na jedlo je uzavretá</h2>
          <p>Ak sa chceš ešte prihlásiť, zavolaj nám:</p>
          <a href={`tel:${page.countdown.deadlinePhone}`} class="poster-button poster-button-lime">
            Zavolať {page.countdown.deadlinePhone}
          </a>
          <p>Možno ešte stíhame pridať porciu!</p>
        </div>

        <div class="counter-poster">
          <span id="counter-value" class="counter-number">0</span>
          <span>registrovaných na jedlo</span>
        </div>
      </div>
    </section>

    <!-- Section 4: Activities Showcase -->
    <section id="aktivity" class="poster-section activities-poster-section">
      <div class="poster-wrap activities-layout">
        <div class="poster-heading">
          <h2>Čo ťa čaká?</h2>
          <p>Každý piatok je nabitý aktivitami</p>
        </div>
        <div class="activity-row" aria-label="Aktivity">
          {page.activities.map((item: { emoji: string; title: string; description: string }, index: number) => {
            const activityPhoto = activityPhotos[index] || partyPhotos[index % partyPhotos.length]?.image;
            return (
            <div class={`activity-item activity-item-${(index % 4) + 1}`}>
              <div class="activity-image">
                {activityPhoto ? (
                  <img src={activityPhoto} alt={item.title} loading="lazy" width="520" height="420">
                ) : (
                  <span class="activity-emoji-fallback" set:html={item.emoji}></span>
                )}
              </div>
              <div class="activity-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Section 5: Photo Gallery -->
    <section class="poster-section gallery-poster-section">
      <div class="poster-wrap">
        <div class="gallery-layout">
          <div class="poster-heading">
            <h2>Fotogaléria</h2>
            <p>Pozri sa, ako to u nás vyzerá</p>
          </div>
          <div class="gallery-collage">
            {partyPhotos.map((photo, index: number) => (
              <button class={`gallery-item gallery-polaroid gallery-polaroid-${(index % 6) + 1}`} type="button" data-index={index} data-src={photo.image} data-caption={photo.caption}>
                <img src={photo.image} alt={photo.caption} loading="lazy" width="450" height="600">
                <span>{photo.caption}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox-overlay">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-[var(--color-primary)] transition-colors z-10">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white hover:text-[var(--color-primary)] transition-colors">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white hover:text-[var(--color-primary)] transition-colors">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-image" src="" alt="">
      <p id="lightbox-caption" class="text-white text-center mt-4 text-lg"></p>
    </div>
  </div>

    <!-- Section 6: Registration Form -->
    <section id="registracia" class="registration-poster-section">
      <div class="registration-poster-noise" aria-hidden="true"></div>
      <div class="registration-poster-wrap">
      <div class="registration-poster-header">
        <h2>{page.registration.formTitle}</h2>
        <p>Zaregistruj sa a príď v piatok!</p>
      </div>
      <div class="registration-poster-layout">
        <!-- Info Panel -->
        <div class="registration-info-poster">
          <div class="registration-info-list">
            <div class="registration-info-item">
              <div class="registration-info-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3>Kedy</h3>
                <p>{page.registration.time}</p>
              </div>
            </div>
            <div class="registration-info-item">
              <div class="registration-info-icon registration-info-icon-lime">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3>Kde</h3>
                <p>{contactInfo.address}, {contactInfo.city}, {contactInfo.postalCode}</p>
              </div>
            </div>
            <div class="registration-info-item">
              <div class="registration-info-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3>Cena</h3>
                <p>{page.registration.price}</p>
              </div>
            </div>
          </div>
          <div class="registration-map">
            <iframe src={contactInfo.googleMapsEmbed} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="New Level Church - mapa"></iframe>
          </div>
        </div>
        <!-- Form Card -->
        <div class="registration-form-poster">
          <div class="registration-form-mark" aria-hidden="true"></div>
          <div class="registration-form-inner">
            <h3>{page.registration.formTitle}</h3>
            <div id="form-success" class="hidden registration-message registration-message-success">
              <p>Super! Registrácia úspešná. Tešíme sa na teba v piatok!</p>
            </div>
            <div id="form-error" class="hidden registration-message registration-message-error">
              <p>Ups! Niečo sa pokazilo. Skús to prosím znovu.</p>
            </div>
            <form id="party-form" class="registration-form">
              <div class="registration-field">
                <label for="party-name">Meno</label>
                <input type="text" id="party-name" name="name" required autocomplete="name" placeholder="Tvoje meno">
              </div>
              <div class="registration-field">
                <label for="party-email">Email</label>
                <input type="email" id="party-email" name="email" required autocomplete="email" inputmode="email" placeholder="tvoj@email.sk">
              </div>
              <div class="registration-field">
                <label for="party-phone">Telefón (voliteľné)</label>
                <input type="tel" id="party-phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="+421 ...">
              </div>
              <div class="registration-food-option">
                <input type="checkbox" id="party-food" name="food_registration" value="Ano">
                <label for="party-food">Objednávam si 1 porciu jedla od šéfkuchára</label>
              </div>
              <div class="registration-field">
                <label for="party-message">Správa (voliteľné)</label>
                <textarea id="party-message" name="message" rows="3" placeholder="Chceš nám niečo odkázať?"></textarea>
              </div>
              <button type="submit" id="party-submit">
                Odoslať registráciu
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    </section>

    <!-- Section 7: CTA Banner -->
    <section class="poster-section final-cta-section">
      <div class="poster-wrap final-cta-layout">
        <div>
          <h2>{page.cta.title}</h2>
          <p>{page.cta.text}</p>
        </div>
        <a href={page.cta.buttonUrl} target="_blank" rel="noopener noreferrer" class="poster-button poster-button-lime">
          {page.cta.buttonText}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .registration-poster-section {
    --party-paper: #f6f4ee;
    --party-ink: #111111;
    --party-purple: #7b3eff;
    --party-lime: #d7ff27;
    --party-gray: #777777;
    --poster-display: "Barlow Condensed", Impact, "Arial Narrow", Inter, system-ui, sans-serif;
    --poster-sans: Inter, system-ui, sans-serif;
    position: relative;
    overflow: hidden;
    scroll-margin-top: 5rem;
    padding: 4.5rem 0;
    background:
      linear-gradient(90deg, rgba(17, 17, 17, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(17, 17, 17, 0.035) 1px, transparent 1px),
      var(--party-paper);
    background-size: 48px 48px, 48px 48px, auto;
    color: var(--party-ink);
    font-family: var(--poster-sans);
    isolation: isolate;
  }

  .registration-poster-noise {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.52;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(17, 17, 17, 0.08) 0 1px, transparent 1.5px),
      radial-gradient(circle at 70% 60%, rgba(17, 17, 17, 0.06) 0 1px, transparent 1.5px);
    background-size: 15px 15px, 19px 19px;
    mix-blend-mode: multiply;
  }

  .registration-poster-wrap {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .registration-poster-header {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .registration-poster-header h2 {
    max-width: 8ch;
    margin: 0;
    color: var(--party-ink);
    font-family: var(--poster-display);
    font-size: 7rem;
    font-weight: 900;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .registration-poster-header p {
    display: inline-block;
    margin: 1rem 0 0;
    padding: 0.45rem 0.8rem;
    background: var(--party-lime);
    color: var(--party-ink);
    font-family: var(--poster-sans);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
    transform: rotate(-1.5deg);
    box-shadow: 6px 6px 0 var(--party-ink);
  }

  .registration-poster-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .registration-info-poster,
  .registration-form-poster {
    position: relative;
    border: 2px solid var(--party-ink);
    background: rgba(246, 244, 238, 0.94);
    box-shadow: 10px 10px 0 var(--party-ink);
  }

  .registration-info-poster {
    padding: 2rem;
    transform: rotate(-0.8deg);
  }

  .registration-info-list {
    display: grid;
    gap: 1rem;
  }

  .registration-info-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(17, 17, 17, 0.14);
  }

  .registration-info-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .registration-info-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 2px solid var(--party-ink);
    border-radius: 999px;
    background: var(--party-purple);
    color: white;
  }

  .registration-info-icon-lime {
    background: var(--party-lime);
    color: var(--party-ink);
  }

  .registration-info-icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .registration-info-item h3 {
    margin: 0 0 0.2rem;
    color: var(--party-ink);
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .registration-info-item p {
    margin: 0;
    color: var(--party-gray);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .registration-map {
    aspect-ratio: 16 / 10;
    margin-top: 1.5rem;
    overflow: hidden;
    border: 2px solid var(--party-ink);
    background: var(--party-ink);
  }

  .registration-form-poster {
    background:
      linear-gradient(135deg, rgba(123, 62, 255, 0.08) 0 25%, transparent 25% 100%),
      var(--party-paper);
  }

  .registration-form-mark {
    position: absolute;
    top: 1.2rem;
    right: 1rem;
    width: 6.25rem;
    height: 6.25rem;
    border: 0.65rem solid var(--party-lime);
    border-radius: 50%;
    opacity: 0.9;
    transform: rotate(12deg);
    pointer-events: none;
  }

  .registration-form-inner {
    position: relative;
    padding: 2rem;
  }

  .registration-form-inner h3 {
    max-width: 8ch;
    margin: 0 0 1.5rem;
    color: var(--party-ink);
    font-family: var(--poster-display);
    font-size: 3.8rem;
    font-weight: 900;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .registration-message {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    margin-bottom: 1.25rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--party-ink);
    color: var(--party-ink);
    text-align: center;
    transform: rotate(-0.7deg);
  }

  .registration-message.hidden {
    display: none;
  }

  .registration-message p {
    margin: 0;
    font-weight: 900;
    line-height: 1.25;
  }

  .registration-message-success {
    background: var(--party-lime);
  }

  .registration-message-error {
    background: var(--party-purple);
    color: white;
  }

  .registration-form {
    display: grid;
    gap: 1rem;
  }

  .registration-field label,
  .registration-food-option label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--party-ink);
    font-size: 0.76rem;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .registration-field input,
  .registration-field textarea {
    width: 100%;
    border: 2px solid var(--party-ink);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.68);
    color: var(--party-ink);
    padding: 0.95rem 1rem;
    font: 800 1rem/1.25 Inter, system-ui, sans-serif;
    outline: none;
    box-shadow: 4px 4px 0 rgba(17, 17, 17, 0.18);
    transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .registration-field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .registration-field input::placeholder,
  .registration-field textarea::placeholder {
    color: rgba(119, 119, 119, 0.72);
    font-weight: 700;
  }

  .registration-field input:focus,
  .registration-field textarea:focus {
    background: white;
    box-shadow: 6px 6px 0 var(--party-purple);
    transform: translate(-1px, -1px);
  }

  .registration-food-option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 1rem;
    border: 2px solid var(--party-ink);
    background: var(--party-lime);
    box-shadow: 4px 4px 0 rgba(17, 17, 17, 0.22);
  }

  .registration-food-option input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.05rem 0 0;
    accent-color: var(--party-purple);
  }

  .registration-food-option label {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.25;
  }

  #party-submit {
    width: 100%;
    min-height: 3.75rem;
    margin-top: 0.25rem;
    border: 2px solid var(--party-ink);
    border-radius: 999px;
    background: var(--party-purple);
    color: white;
    padding: 0.95rem 1.5rem;
    font: 900 1rem/1 Inter, system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0;
    box-shadow: 6px 6px 0 var(--party-ink);
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  #party-submit:hover,
  #party-submit:focus-visible {
    background: var(--party-ink);
    box-shadow: 6px 6px 0 var(--party-lime);
    transform: translate(-1px, -1px);
  }

  #party-submit:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  @media (max-width: 900px) {
    .registration-poster-section {
      padding: 3.5rem 0;
    }

    .registration-poster-header {
      margin-bottom: 2rem;
    }

    .registration-poster-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .registration-info-poster {
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .registration-poster-wrap {
      width: min(100% - 1.25rem, 1120px);
    }

    .registration-poster-header h2 {
      max-width: 7.25ch;
      font-size: 4.15rem;
      line-height: 1.02;
    }

    .registration-poster-header p {
      max-width: calc(100% - 0.5rem);
      box-shadow: 4px 4px 0 var(--party-ink);
    }

    .registration-info-poster,
    .registration-form-poster {
      box-shadow: 6px 6px 0 var(--party-ink);
    }

    .registration-info-poster,
    .registration-form-inner {
      padding: 1.25rem;
    }

    .registration-form-inner h3 {
      font-size: 3.05rem;
      line-height: 1.02;
    }

    .registration-form-mark {
      width: 4.5rem;
      height: 4.5rem;
      border-width: 0.5rem;
      opacity: 0.7;
    }

    .registration-info-item {
      grid-template-columns: 2.6rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .registration-info-icon {
      width: 2.6rem;
      height: 2.6rem;
    }

    .registration-map {
      aspect-ratio: 4 / 3;
    }
  }

  :global(body) {
    background: #f6f4ee;
  }

  :global(header) {
    background: rgba(246, 244, 238, 0.94) !important;
    border-bottom: 2px solid #111111;
    box-shadow: none !important;
    backdrop-filter: blur(10px);
  }

  :global(header nav a) {
    color: #111111 !important;
    font-weight: 900 !important;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  :global(header img) {
    filter: invert(1) grayscale(1) contrast(1.8);
  }

  :global(header nav a[aria-label]),
  :global(header nav a[aria-label] svg) {
    color: #111111 !important;
  }

  :global(header nav a:last-child) {
    background: #7b3eff !important;
    color: #ffffff !important;
    border: 2px solid #111111;
    border-radius: 0.25rem !important;
    box-shadow: 4px 4px 0 #111111;
  }

  :global(#mobile-menu) {
    background: #f6f4ee;
  }

  :global(.social-sidebar-link span:first-child) {
    background: #111111 !important;
    color: #f6f4ee !important;
  }

  .party-page-shell {
    --party-paper: #f6f4ee;
    --party-ink: #111111;
    --party-purple: #7b3eff;
    --party-lime: #d7ff27;
    --party-gray: #777777;
    --poster-display: "Barlow Condensed", Impact, "Arial Narrow", Inter, system-ui, sans-serif;
    --poster-sans: Inter, system-ui, sans-serif;
    overflow: hidden;
    background: var(--party-paper);
    color: var(--party-ink);
    font-family: var(--poster-sans);
  }

  .poster-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .poster-section {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 5rem;
    border-bottom: 2px solid rgba(17, 17, 17, 0.22);
    background:
      radial-gradient(circle at 20% 30%, rgba(17, 17, 17, 0.04) 0 1px, transparent 1.6px),
      linear-gradient(90deg, rgba(17, 17, 17, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(17, 17, 17, 0.04) 1px, transparent 1px),
      var(--party-paper);
    background-size: 21px 21px, 68px 68px, 68px 68px, auto;
    isolation: isolate;
  }

  .poster-noise {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(17, 17, 17, 0.15) 0 1px, transparent 1.5px),
      radial-gradient(circle at 83% 42%, rgba(17, 17, 17, 0.08) 0 1px, transparent 1.5px);
    background-size: 23px 23px, 31px 31px;
    mix-blend-mode: multiply;
  }

  .poster-wrap {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .poster-heading h2,
  .hero-copy h1,
  .menu-ticket h3,
  .countdown-poster h2,
  .deadline-poster h2,
  .final-cta-layout h2 {
    font-family: var(--poster-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .poster-heading {
    max-width: min(100%, 42rem);
  }

  .poster-heading h2 {
    max-width: 8.5ch;
    margin: 0;
    font-size: 6.25rem;
    line-height: 1.02;
    text-wrap: balance;
  }

  .poster-heading p {
    display: inline-block;
    max-width: min(100%, 31rem);
    margin: 0.85rem 0 0;
    padding: 0.35rem 0.55rem;
    background: var(--party-lime);
    color: var(--party-ink);
    font-family: var(--poster-sans);
    font-weight: 900;
    line-height: 1.2;
    box-shadow: 5px 5px 0 var(--party-ink);
    transform: rotate(-1deg);
  }

  .menu-layout .poster-heading h2 {
    max-width: 7.25ch;
  }

  .countdown-poster .poster-heading h2 {
    max-width: 13.5ch;
    font-size: 5rem;
    line-height: 1.02;
  }

  .countdown-poster .poster-heading h2 span {
    display: block;
    white-space: nowrap;
  }

  .countdown-poster .poster-heading h2 span + span {
    margin-top: 0;
  }

  .activities-poster-section .poster-heading h2 {
    max-width: 7.15ch;
  }

  .gallery-poster-section .poster-heading h2 {
    max-width: 9.5ch;
  }

  .poster-heading-invert h2,
  .poster-heading-invert p {
    color: var(--party-paper);
  }

  .poster-heading-invert p {
    color: var(--party-ink);
  }

  .poster-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    border: 2px solid var(--party-ink);
    border-radius: 0.25rem;
    background: var(--party-purple);
    color: #ffffff;
    padding: 0.85rem 1.4rem;
    font-family: var(--poster-sans);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 5px 5px 0 var(--party-ink);
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .poster-button:hover,
  .poster-button:focus-visible {
    background: var(--party-ink);
    color: #ffffff;
    box-shadow: 5px 5px 0 var(--party-lime);
    transform: translate(-1px, -1px);
  }

  .poster-button-lime {
    background: var(--party-lime);
    color: var(--party-ink);
  }

  .poster-sticker {
    display: inline-block;
    background: var(--party-lime);
    color: var(--party-ink);
    padding: 0.42rem 0.65rem;
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
    box-shadow: 5px 5px 0 var(--party-ink);
    transform: rotate(-1.5deg);
  }

  .hero-poster {
    padding: clamp(2.4rem, 4vw, 3.4rem) 0 clamp(2.6rem, 4.8vw, 4rem);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(320px, 1.18fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .hero-copy h1 {
    position: relative;
    width: min-content;
    margin: 0 0 0.35rem;
    font-size: 9.7rem;
    line-height: 0.9;
    filter: url("#print-distress");
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy h1 span {
    display: block;
  }

  .hero-copy h1 span:first-child {
    max-width: 4.05em;
  }

  .hero-copy h1 span:last-child {
    color: var(--party-purple);
    width: 3.2em;
    margin-top: 0.02em;
    font-size: 0.74em;
    line-height: 0.98;
    position: relative;
    text-shadow: none;
  }

  .hero-copy h1 span:last-child::after {
    content: "";
    position: absolute;
    left: -0.1em;
    right: -0.42em;
    bottom: -0.07em;
    z-index: -1;
    height: 0.16em;
    background: var(--party-lime);
    transform: rotate(-2.8deg);
  }

  .hero-badge {
    position: relative;
    display: inline-block;
    margin: 0.55rem 0 0;
    padding: 0.48rem 1.1rem 0.42rem;
    background: var(--party-ink);
    color: var(--party-paper);
    font-family: var(--poster-sans);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .hero-badge::before,
  .hero-badge::after {
    content: "";
    position: absolute;
    inset: -0.24rem -0.5rem;
    z-index: -1;
    background: var(--party-ink);
    transform: rotate(1.5deg) skewX(-8deg);
  }

  .hero-badge::after {
    inset: auto 12% -0.8rem 16%;
    height: 0.18rem;
    background: var(--party-lime);
    transform: rotate(-1deg);
  }

  .hero-secondary {
    margin-top: 1.15rem;
  }

  .hero-copy p {
    max-width: 30rem;
    margin: 0 0 1.1rem;
    color: var(--party-ink);
    font-family: var(--poster-sans);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.25;
    text-wrap: balance;
  }

  .scroll-sticker {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.75rem;
    color: var(--party-gray);
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scroll-sticker svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }

  .hero-photo-stack {
    position: relative;
    max-width: 42rem;
    justify-self: end;
    transform: rotate(1.2deg);
  }

  .hero-photo-stack img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 2px solid var(--party-ink);
    object-fit: cover;
    filter: saturate(1.08) contrast(1.06);
    box-shadow: 10px 10px 0 var(--party-ink);
  }

  .info-strip-section {
    padding: 1.1rem 0;
    background: var(--party-ink);
  }

  .quick-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 2px solid var(--party-ink);
    background: var(--party-ink);
  }

  .quick-strip-item {
    padding: 1.25rem;
    background: var(--party-paper);
  }

  .quick-strip-item span {
    display: block;
    color: var(--party-purple);
    font-weight: 900;
  }

  .quick-strip-item h2 {
    margin: 0.15rem 0 0.25rem;
    font-family: var(--poster-display);
    font-size: 3.25rem;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .quick-strip-item p {
    margin: 0;
    color: var(--party-gray);
    font-weight: 800;
    line-height: 1.25;
  }

  .menu-poster-section,
  .activities-poster-section,
  .gallery-poster-section,
  .registration-poster-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
  }

  .menu-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .menu-ticket {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    border: 2px solid var(--party-ink);
    background: var(--party-paper);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 10px 10px 0 var(--party-ink);
    transform: rotate(0.8deg);
  }

  .menu-ticket > div {
    min-width: 0;
  }

  .menu-ticket::after {
    content: "";
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 8rem;
    height: 2rem;
    background: var(--party-lime);
    transform: rotate(-3deg);
    z-index: -1;
  }

  .menu-emoji {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border: 2px solid var(--party-ink);
    border-radius: 999px;
    background: var(--party-lime);
    font-size: 2.35rem;
  }

  .menu-ticket h3 {
    margin: 0;
    color: var(--party-purple);
    font-size: 5rem;
    line-height: 1.12;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .menu-ticket p {
    margin: 0.55rem 0 0;
    color: var(--party-ink);
    font-size: 1.15rem;
    font-weight: 900;
  }

  .menu-ticket .poster-button {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .countdown-poster-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: var(--party-ink);
  }

  .countdown-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 1.25rem;
    align-items: stretch;
  }

  .countdown-poster,
  .deadline-poster,
  .counter-poster {
    border: 2px solid var(--party-paper);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .countdown-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .countdown-grid div {
    border: 2px solid var(--party-paper);
    background: var(--party-lime);
    color: var(--party-ink);
    padding: 1rem 0.75rem;
    text-align: center;
  }

  .countdown-number {
    display: block;
    font-family: var(--poster-display);
    font-size: 4.8rem;
    font-weight: 900;
    line-height: 1;
  }

  .countdown-grid span:last-child,
  .counter-poster span:last-child {
    display: block;
    margin-top: 0.35rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .deadline-poster {
    grid-column: 1 / -1;
    color: var(--party-paper);
    text-align: center;
  }

  .deadline-poster.hidden {
    display: none;
  }

  .deadline-poster h2 {
    margin: 0 0 0.65rem;
    font-size: 4.5rem;
    line-height: 1.02;
  }

  .deadline-poster p {
    margin: 0.8rem 0;
    font-weight: 800;
  }

  .counter-poster {
    display: grid;
    align-content: center;
    background: var(--party-purple);
    color: var(--party-paper);
    text-align: center;
  }

  .counter-number {
    font-family: var(--poster-display);
    font-size: 8rem;
    font-weight: 900;
    line-height: 0.95;
  }

  .activity-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  .activity-item {
    position: relative;
    min-height: 19rem;
    overflow: hidden;
    border-top: 2px solid var(--party-ink);
    padding: 0.7rem 0.5rem 0;
    text-align: left;
  }

  .activity-image {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--party-ink);
    background: var(--party-ink);
  }

  .activity-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(1.06) contrast(1.05);
  }

  .activity-image::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(180deg, transparent, rgba(17, 17, 17, 0.68));
    pointer-events: none;
  }

  .activity-emoji-fallback {
    display: grid;
    min-height: 12rem;
    place-items: center;
    font-size: 4rem;
  }

  .activity-copy {
    padding-top: 0.9rem;
  }

  .activity-item h3 {
    margin: 0;
    color: var(--party-ink);
    font-family: var(--poster-display);
    font-size: 1.95rem;
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .activity-item p {
    margin: 0.65rem 0 0;
    color: var(--party-gray);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .gallery-layout {
    display: grid;
    grid-template-columns: minmax(30rem, 0.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .gallery-collage {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.8rem;
  }

  .gallery-polaroid {
    position: relative;
    display: block;
    grid-column: span 2;
    min-width: 0;
    border: 2px solid var(--party-ink);
    background: var(--party-paper);
    padding: 0.5rem 0.5rem 2.4rem;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.85);
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .gallery-polaroid:hover,
  .gallery-polaroid:focus-visible {
    transform: rotate(0deg) translateY(-0.25rem) !important;
    box-shadow: 8px 8px 0 var(--party-ink);
    outline: none;
  }

  .gallery-polaroid img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: saturate(1.06) contrast(1.05);
  }

  .gallery-polaroid span {
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.55rem;
    overflow: hidden;
    color: var(--party-ink);
    font-weight: 900;
    line-height: 1;
    text-align: left;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .gallery-polaroid-1,
  .gallery-polaroid-5 {
    transform: rotate(-1.5deg);
  }

  .gallery-polaroid-2,
  .gallery-polaroid-6 {
    transform: rotate(1.2deg);
  }

  .gallery-polaroid-3 {
    transform: rotate(-0.4deg);
  }

  .gallery-polaroid-4 {
    transform: rotate(1.8deg);
  }

  .registration-poster-section {
    background:
      radial-gradient(circle at 20% 30%, rgba(17, 17, 17, 0.055) 0 1px, transparent 1.6px),
      linear-gradient(90deg, rgba(17, 17, 17, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(17, 17, 17, 0.04) 1px, transparent 1px),
      var(--party-paper);
    background-size: 17px 17px, 58px 58px, 58px 58px, auto;
  }

  .registration-form-poster {
    background: var(--party-paper);
  }

  .final-cta-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    background: var(--party-lime);
  }

  .final-cta-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
  }

  .final-cta-layout h2 {
    max-width: 7.5ch;
    margin: 0;
    font-size: 7rem;
    line-height: 1.02;
    text-wrap: balance;
  }

  .final-cta-layout p {
    display: inline-block;
    margin: 1rem 0 0;
    padding: 0.5rem 0.8rem;
    background: var(--party-ink);
    color: var(--party-paper);
    font-weight: 900;
    transform: rotate(-1deg);
  }

  @media (max-width: 980px) {
    .hero-grid,
    .menu-layout,
    .countdown-layout,
    .gallery-layout,
    .final-cta-layout {
      grid-template-columns: 1fr;
    }

    .activity-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .counter-poster {
      min-height: 12rem;
    }

    .hero-copy h1 {
      font-size: 8rem;
    }

    .poster-heading h2 {
      font-size: 5.25rem;
    }

    .final-cta-layout h2 {
      font-size: 5.8rem;
    }
  }

  @media (max-width: 1180px) {
    .gallery-layout {
      grid-template-columns: 1fr;
    }

    .gallery-collage {
      max-width: 58rem;
    }
  }

  @media (max-width: 680px) {
    .hero-poster {
      padding-top: 3rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.57fr) minmax(8.2rem, 0.43fr);
      gap: 0.65rem;
      align-items: start;
    }

    .hero-copy {
      display: contents;
    }

    .hero-copy h1 {
      grid-column: 1;
      grid-row: 1;
      font-size: 5.65rem;
      line-height: 0.92;
    }

    .hero-photo-stack {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: none;
      margin-top: 1.15rem;
      justify-self: stretch;
      transform: rotate(1.1deg);
    }

    .hero-photo-stack img {
      aspect-ratio: 3 / 4;
      box-shadow: 6px 6px 0 var(--party-ink);
    }

    .hero-badge,
    .hero-secondary,
    .scroll-sticker {
      grid-column: 1 / -1;
    }

    .poster-heading {
      max-width: 100%;
    }

    .poster-heading h2 {
      max-width: 6.75ch;
      font-size: 4.45rem;
      line-height: 1.02;
    }

    .menu-layout .poster-heading h2 {
      max-width: 6.1ch;
    }

    .countdown-poster .poster-heading h2 {
      max-width: 13ch;
      font-size: 3.15rem;
      line-height: 1.02;
    }

    .activities-poster-section .poster-heading h2 {
      max-width: 6.45ch;
    }

    .gallery-poster-section .poster-heading h2 {
      max-width: 8.6ch;
    }

