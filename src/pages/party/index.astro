---
const targetPath = '/youth';
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${targetPath}`} />
    <link rel="canonical" href={targetPath} />
    <title>Presmerovanie na Youth | New Level Church</title>
    <script is:inline>
      window.location.replace('/youth' + window.location.search + window.location.hash);
    </script>
  </head>
  <body>
    <p>Presmerovanie na <a href={targetPath}>Youth</a>.</p>
  </body>
</html>
