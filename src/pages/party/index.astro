<script type="module">
(() => {
  const track = document.querySelector('[data-reels-track]');
  const slides = Array.from(document.querySelectorAll('[data-reel-slide]'));
  const prev = document.querySelector('[data-reels-prev]');
  const next = document.querySelector('[data-reels-next]');
  const counter = document.querySelector('[data-reels-counter]');

  if (!track || !slides.length || !counter) return;

  let active = 0;
  let startX = 0;
  let startScroll = 0;
  let pointerDown = false;
  let dragging = false;
  let scrollTimer = 0;

  function format(index) {
    counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
  }

  function nearestIndex() {
    const trackLeft = track.getBoundingClientRect().left;
    return slides.reduce((best, slide, index) => {
      const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
      return distance < best.distance ? { index, distance } : best;
    }, { index: 0, distance: Number.POSITIVE_INFINITY }).index;
  }

  function setActive(index) {
    active = Math.max(0, Math.min(index, slides.length - 1));
    format(active);
  }

  function goTo(index) {
    const target = slides[Math.max(0, Math.min(index, slides.length - 1))];
    if (!target) return;

    target.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      block: 'nearest',
      inline: 'start',
    });
  }

  prev?.addEventListener('click', () => goTo(active - 1));
  next?.addEventListener('click', () => goTo(active + 1));

  track.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      goTo(active - 1);
    }

    if (event.key === 'ArrowRight') {
      event.preventDefault();
      goTo(active + 1);
    }
  });

  track.addEventListener('scroll', () => {
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => setActive(nearestIndex()), 80);
  }, { passive: true });

  track.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'touch') return;
    pointerDown = true;
    dragging = false;
    startX = event.clientX;
    startScroll = track.scrollLeft;
  });

  track.addEventListener('pointermove', (event) => {
    if (!pointerDown || event.pointerType === 'touch') return;
    const distance = event.clientX - startX;
    if (Math.abs(distance) > 4) {
      dragging = true;
      track.classList.add('is-dragging');
      track.scrollLeft = startScroll - distance;
    }
  });

  function stopDrag() {
    if (!pointerDown) return;
    pointerDown = false;
    track.classList.remove('is-dragging');

    if (dragging) {
      goTo(nearestIndex());
      window.setTimeout(() => {
        dragging = false;
      }, 0);
    }
  }

  track.addEventListener('pointerup', stopDrag);
  track.addEventListener('pointercancel', stopDrag);
  track.addEventListener('pointerleave', stopDrag);

  track.addEventListener('click', (event) => {
    if (dragging) {
      event.preventDefault();
      event.stopPropagation();
    }
  }, true);

  format(active);
})();
</script>

<script type="module">
const items=document.querySelectorAll(".gallery-item"),lb=document.getElementById("lightbox"),lbImg=document.getElementById("lightbox-image"),lbCap=document.getElementById("lightbox-caption"),closeBtn=document.getElementById("lightbox-close"),prevBtn=document.getElementById("lightbox-prev"),nextBtn=document.getElementById("lightbox-next");let idx=0;const data=Array.from(items).map(i=>({src:i.getAttribute("data-src")||"",caption:i.getAttribute("data-caption")||""}));function open(i){idx=i;update();lb?.classList.add("active");document.body.style.overflow="hidden";}function close(){lb?.classList.remove("active");document.body.style.overflow="";}function update(){if(lbImg&&lbCap){lbImg.src=data[idx].src;lbCap.textContent=data[idx].caption;}}function next(){idx=(idx+1)%data.length;update();}function prev(){idx=(idx-1+data.length)%data.length;update();}items.forEach((el,i)=>{el.addEventListener("click",()=>open(i));});closeBtn?.addEventListener("click",close);nextBtn?.addEventListener("click",next);prevBtn?.addEventListener("click",prev);lb?.addEventListener("click",e=>{if(e.target===lb)close();});document.addEventListener("keydown",e=>{if(lb?.classList.contains("active")){if(e.key==="Escape")close();if(e.key==="ArrowRight")next();if(e.key==="ArrowLeft")prev();}});
</script>

<script type="module">
(function() {
  const daysEl = document.getElementById('countdown-days');
  const hoursEl = document.getElementById('countdown-hours');
  const minutesEl = document.getElementById('countdown-minutes');
  const secondsEl = document.getElementById('countdown-seconds');
  const countdownSection = document.getElementById('countdown-section');
  const deadlinePassed = document.getElementById('deadline-passed');
  const counterPoster = document.getElementById('counter-poster');
  const counterEl = document.getElementById('counter-value');
  const deadlineCounterEl = document.getElementById('deadline-counter-value');
  let lastCount = -1;

  function getNextThursdayMidnight() {
    const now = new Date();
    const day = now.getDay(); // 0=Sun, 4=Thu
    let daysUntilThursday = (4 - day + 7) % 7;
    // If it's Thursday, check if we're past midnight
    if (daysUntilThursday === 0) {
      // Thursday - deadline is end of today (23:59:59)
      const endOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
      if (now <= endOfToday) {
        return endOfToday;
      }
      // Past Thursday midnight, next Thursday
      daysUntilThursday = 7;
    }
    const target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + daysUntilThursday, 23, 59, 59, 999);
    return target;
  }

  function isDeadlinePassed() {
    const now = new Date();
    const day = now.getDay();
    const hour = now.getHours();
    // Friday (5) = deadline passed (until new week resets on next Monday-ish, but we show it until Saturday)
    // After Thursday midnight = Friday
    if (day === 5) return true;
    if (day === 6) return true; // Saturday too
    return false;
  }

  function updateCountdown() {
    if (isDeadlinePassed()) {
      countdownSection?.classList.add('hidden');
      deadlinePassed?.classList.remove('hidden');
      counterPoster?.classList.add('hidden');
      return;
    }

    countdownSection?.classList.remove('hidden');
    deadlinePassed?.classList.add('hidden');
    counterPoster?.classList.remove('hidden');

    const now = new Date();
    const target = getNextThursdayMidnight();
    const diff = target - now;

    if (diff <= 0) {
      // Just passed - show deadline passed
      countdownSection?.classList.add('hidden');
      deadlinePassed?.classList.remove('hidden');
      counterPoster?.classList.add('hidden');
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (daysEl) daysEl.textContent = days;
    if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
    if (minutesEl) minutesEl.textContent = minutes.toString().padStart(2, '0');
    if (secondsEl) secondsEl.textContent = seconds.toString().padStart(2, '0');
  }

  async function fetchCounter() {
    try {
      const res = await fetch('/api/counter', { cache: 'no-store' });
      if (!res.ok) throw new Error('Counter request failed');
      const data = await res.json();
      const count = Number.isFinite(Number(data.count)) ? Number(data.count) : 0;
      if (deadlineCounterEl) deadlineCounterEl.textContent = count;
      if (counterEl) {
        if (lastCount !== -1 && count !== lastCount) {
          counterEl.classList.remove('counter-pop');
          void counterEl.offsetWidth; // trigger reflow
          counterEl.classList.add('counter-pop');
        }
        counterEl.textContent = count;
        lastCount = count;
      }
    } catch (e) {
      if (counterEl && lastCount === -1) counterEl.textContent = '--';
      if (deadlineCounterEl && lastCount === -1) deadlineCounterEl.textContent = '--';
    }
  }

  // Start countdown
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Fetch counter on load and every 30 seconds
  fetchCounter();
  setInterval(fetchCounter, 30000);
  window.addEventListener('party-counter-refresh', fetchCounter);
})();
</script>

<script type="module">
const form=document.getElementById("party-form"),successMsg=document.getElementById("form-success"),errorMsg=document.getElementById("form-error"),submitBtn=document.getElementById("party-submit");
const savedRegistrationKey="newlevel-party-registration";
const savedRegistrationMaxAge=1000*60*60*24*180;

function getSavedRegistration(){
  try{
    const raw=localStorage.getItem(savedRegistrationKey);
    if(!raw)return null;
    const saved=JSON.parse(raw);
    if(!saved.savedAt||Date.now()-saved.savedAt>savedRegistrationMaxAge){
      localStorage.removeItem(savedRegistrationKey);
      return null;
    }
    return saved;
  }catch{
    return null;
  }
}

function prefillRegistration(){
  if(!form)return;
  const saved=getSavedRegistration();
  if(!saved)return;
  const name=form.querySelector('[name="name"]');
  const email=form.querySelector('[name="email"]');
  const phone=form.querySelector('[name="phone"]');
  const food=form.querySelector('[name="food_registration"]');
  if(name&&!name.value)name.value=saved.name||"";
  if(email&&!email.value)email.value=saved.email||"";
  if(phone&&!phone.value)phone.value=saved.phone||"";
  if(food)food.checked=Boolean(saved.food_registration);
}

function saveRegistration(fd){
  try{
    localStorage.setItem(savedRegistrationKey,JSON.stringify({
      name:fd.name||"",
      email:fd.email||"",
      phone:fd.phone||"",
      food_registration:Boolean(fd.food_registration),
      savedAt:Date.now()
    }));
  }catch{
    // Browser storage can be unavailable in some private modes.
  }
}

prefillRegistration();

form?.addEventListener("submit",async(e)=>{
  e.preventDefault();
  submitBtn.disabled=true;
  submitBtn.textContent="Odosielam...";
  successMsg?.classList.add("hidden");
  errorMsg?.classList.add("hidden");
  try{
    const fd=Object.fromEntries(new FormData(form));
    const res=await fetch("/api/register",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({name:fd.name,email:fd.email,phone:fd.phone||'',food_registration:fd.food_registration||'',message:fd.message||''})});
    const data=await res.json();
    if(data.success){
      saveRegistration(fd);
      successMsg?.classList.remove("hidden");
      form.reset();
      window.dispatchEvent(new CustomEvent("party-counter-refresh"));
    }else{
      errorMsg?.classList.remove("hidden");
    }
  }catch(err){
    errorMsg?.classList.remove("hidden");
  }finally{
    submitBtn.disabled=false;
    submitBtn.textContent="Odoslať registráciu";
  }
});
</script>
