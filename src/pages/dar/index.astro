---
import BaseLayout from '../../layouts/BaseLayout.astro';
import page from '../../content/dar/page.json';
---

<BaseLayout title="Dar | New Level Church" currentPage="dar">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-[var(--color-primary-light)] via-[var(--color-background)] to-[var(--color-accent-light)] py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-4 py-2 bg-[var(--color-primary-light)] text-[var(--color-primary)] rounded-full text-sm font-medium mb-6">
          {page.hero.badge}
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
          {page.hero.title}
        </h1>
        <p class="text-lg text-[var(--color-text-light)]">
          {page.hero.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Bank Details Section -->
  <section class="py-16 md:py-24 bg-[var(--color-background)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[var(--color-background-alt)] rounded-2xl p-8 md:p-12 shadow-lg">
        <div class="text-center mb-8">
          <div class="w-14 h-14 bg-[var(--color-accent)] rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-4">{page.bankDetails.title}</h2>
          <p class="text-[var(--color-text-light)]">{page.bankDetails.subtitle}</p>
        </div>
        <!-- Bank details -->
        <div class="space-y-6">
          <div class="bg-[var(--color-background)] rounded-xl p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-[var(--color-text-light)] mb-1">IBAN</p>
                <p class="text-lg md:text-xl font-mono font-semibold text-[var(--color-text)]">{page.bankDetails.iban}</p>
              </div>
              <button id="copy-iban-btn" class="flex-shrink-0 ml-4 p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-primary)] hover:bg-[var(--color-primary-light)] transition-colors duration-200" title="Kopírovať IBAN">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              </button>
            </div>
          </div>
          <div class="bg-[var(--color-background)] rounded-xl p-6">
            <p class="text-sm font-medium text-[var(--color-text-light)] mb-1">BIC / SWIFT</p>
            <p class="text-lg font-mono font-semibold text-[var(--color-text)]">{page.bankDetails.bic}</p>
          </div>
        </div>
        <!-- QR Code -->
        <div class="mt-10 text-center">
          <div class="inline-block bg-[var(--color-background)] rounded-2xl p-6 shadow-md">
            <img src={page.bankDetails.qrImage} alt="QR kód pre platbu" class="w-48 h-48 md:w-56 md:h-56 mx-auto">
          </div>
          <p class="mt-4 text-[var(--color-text-light)] text-sm">{page.bankDetails.qrCaption}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-dark)] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        {page.cta.title}
      </h2>
      <p class="text-blue-100 text-lg mb-8">
        {page.cta.text}
      </p>
      <a href={page.cta.buttonUrl} class="inline-flex items-center px-8 py-4 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-semibold rounded-full transition-colors duration-200">
        {page.cta.buttonText}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script type="module" define:vars={{iban: page.bankDetails.iban}}>
  const btn = document.getElementById('copy-iban-btn');
  btn?.addEventListener('click', () => {
    navigator.clipboard.writeText(iban).then(() => {
      btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
      setTimeout(() => {
        btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
      }, 2000);
    });
  });
</script>
