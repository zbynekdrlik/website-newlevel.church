---
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../content/homepage/hero.json';
import aboutPreview from '../content/homepage/about-preview.json';
import values from '../content/homepage/values.json';
import youtube from '../content/homepage/youtube.json';
import joinUs from '../content/homepage/join-us.json';
import contact from '../content/settings/contact.json';
import general from '../content/settings/general.json';
import '../styles/home.css';

const heroBackgrounds = hero.backgroundImages?.length
  ? hero.backgroundImages
  : [{
      image: hero.backgroundImageWebp ?? hero.backgroundImage,
      desktopPosition: 'center center',
      mobilePosition: 'center center',
    }];
const heroBackgroundFallback = heroBackgrounds[0];
const heroVideoPreviewImage = hero.videoPreviewImage ?? hero.imageWebp ?? hero.image;
const heroVideoPreviewAlt = hero.videoPreviewAlt ?? hero.imageAlt;
const latestVideosUrl = `https://www.youtube.com/playlist?list=${youtube.uploadsPlaylistId}`;
const latestVideosEmbedUrl = `https://www.youtube-nocookie.com/embed/videoseries?list=${youtube.uploadsPlaylistId}&rel=0&hl=sk`;
---

<BaseLayout title="Domov | New Level Church" description={hero.subtitle} currentPage="" bodyClass="home-editorial">
  <section class="editorial-hero" data-hero-backgrounds={JSON.stringify(heroBackgrounds)}>
    <div class="editorial-hero__media" aria-hidden="true">
      <img
        src={heroBackgroundFallback.image}
        alt=""
        class="hero-background is-current"
        data-hero-bg-current
        style={`--hero-position: ${heroBackgroundFallback.desktopPosition}; --hero-mobile-position: ${heroBackgroundFallback.mobilePosition};`}
        width="5472"
        height="3648"
        fetchpriority="high"
        decoding="async"
      />
      <img
        src=""
        alt=""
        class="hero-background is-next"
        data-hero-bg-next
        style={`--hero-position: ${heroBackgroundFallback.desktopPosition}; --hero-mobile-position: ${heroBackgroundFallback.mobilePosition};`}
        width="5472"
        height="3648"
        decoding="async"
      />
    </div>
    <div class="editorial-hero__veil"></div>

    <div class="editorial-shell editorial-hero__content">
      <div class="editorial-seal" aria-hidden="true">
        <span>NL</span>
        <small>CHURCH</small>
      </div>
      <p class="editorial-kicker editorial-kicker--light">// SPIŠSKÁ NOVÁ VES · NEDEĽA 10:00</p>
      <h1 class="editorial-display editorial-hero__title">
        <span>{hero.title}</span>
        <strong>{hero.titleAccent}</strong>
        <span class="editorial-accent--blue">{hero.titleSuffix}.</span>
      </h1>
      <p class="editorial-hero__lead">{hero.subtitle}</p>
      <div class="editorial-actions">
        <a href={hero.ctaPrimary.url} class="editorial-button editorial-button--primary">
          {hero.ctaPrimary.text}<span aria-hidden="true">→</span>
        </a>
        <a href={latestVideosUrl} target="_blank" rel="noopener noreferrer" class="editorial-button editorial-button--ghost">
          {hero.ctaSecondary.text}<span aria-hidden="true">▶</span>
        </a>
      </div>

      <div class="editorial-photo-stack" aria-label="Momentky z New Level Church">
        <figure class="editorial-polaroid editorial-polaroid--left">
          <img src={heroBackgrounds[2]?.image ?? heroBackgroundFallback.image} alt="Chvály v New Level Church" width="5472" height="3648" />
        </figure>
        <a href={latestVideosUrl} target="_blank" rel="noopener noreferrer" class="editorial-polaroid editorial-polaroid--center" aria-label={heroVideoPreviewAlt}>
          <img src={heroVideoPreviewImage} alt={heroVideoPreviewAlt} width="1920" height="1280" />
          <span class="editorial-polaroid__play" aria-hidden="true">▶</span>
        </a>
        <figure class="editorial-polaroid editorial-polaroid--right">
          <picture>
            <source srcset={joinUs.imageWebp} type="image/webp" />
            <img src={joinUs.image} alt={joinUs.imageAlt} width="1200" height="800" />
          </picture>
        </figure>
      </div>
    </div>
    <div class="editorial-jagged editorial-jagged--white" aria-hidden="true"></div>
  </section>

  <section class="editorial-section editorial-section--white editorial-about">
    <div class="editorial-shell editorial-about__grid">
      <div>
        <p class="editorial-kicker">// {aboutPreview.badge}</p>
        <h2 class="editorial-display editorial-section__title">MIESTO, KAM <span class="editorial-accent--blue">PATRÍTE.</span></h2>
        <p class="editorial-copy editorial-about__copy">{aboutPreview.text}</p>
        <div class="editorial-actions editorial-actions--left">
          <a href={aboutPreview.ctaPrimary.url} class="editorial-button editorial-button--dark">
            {aboutPreview.ctaPrimary.text}<span aria-hidden="true">→</span>
          </a>
          <a href={aboutPreview.ctaSecondary.url} class="editorial-text-link">
            {aboutPreview.ctaSecondary.text}<span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <aside class="editorial-note" aria-label="Príspevok New Level Church">
        <div class="editorial-note__header">
          <span class="editorial-note__avatar" aria-hidden="true">
            <picture>
              <source srcset="/images/logo.webp" type="image/webp" />
              <img src="/images/logo.png" alt="" width="299" height="200" />
            </picture>
          </span>
          <span class="editorial-note__identity">
            <strong>New Level Church <span class="editorial-note__verified" aria-label="Overený profil">✓</span></strong>
            <small>@newlevelchurch · Spišská Nová Ves</small>
          </span>
          <span class="editorial-note__menu" aria-hidden="true">•••</span>
        </div>
        <p>{joinUs.subtitle}</p>
        <div class="editorial-note__footer">
          <span>NEDEĽA · 10:00</span>
          <a href={general.social.instagram} target="_blank" rel="noopener noreferrer">SLEDOVAŤ <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="editorial-section editorial-section--black editorial-values">
    <div class="editorial-jagged editorial-jagged--black editorial-jagged--top" aria-hidden="true"></div>
    <div class="editorial-shell">
      <div class="editorial-heading-row">
        <div>
          <p class="editorial-kicker editorial-kicker--red">// ČOMU VERÍME</p>
          <h2 class="editorial-display editorial-section__title editorial-section__title--light">NAŠE <span class="editorial-accent--blue">HODNOTY.</span></h2>
        </div>
        <p class="editorial-copy editorial-copy--light">{values.subtitle}</p>
      </div>
      <div class="editorial-values__grid">
        {values.items.map((item: { title: string; description: string }, index: number) => (
          <article class="editorial-value">
            <span class="editorial-value__number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--white editorial-watch">
    <div class="editorial-jagged editorial-jagged--white editorial-jagged--top" aria-hidden="true"></div>
    <div class="editorial-shell editorial-watch__grid">
      <div>
        <p class="editorial-kicker">// KÁZNE · CHVÁLY · KOMUNITA</p>
        <h2 class="editorial-display editorial-section__title">SLEDUJTE <span>ONLINE.</span></h2>
        <p class="editorial-copy">{youtube.subtitle}</p>
        <a href={youtube.url} target="_blank" rel="noopener noreferrer" class="editorial-button editorial-button--primary">
          {youtube.ctaText}<span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="editorial-video">
        <iframe
          src={latestVideosEmbedUrl}
          title="Najnovšie videá New Level Church"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--black editorial-visit">
    <div class="editorial-jagged editorial-jagged--black editorial-jagged--top" aria-hidden="true"></div>
    <div class="editorial-shell">
      <div class="editorial-heading-row editorial-heading-row--visit">
        <div>
          <p class="editorial-kicker editorial-kicker--red">// PRÍĎTE MEDZI NÁS</p>
          <h2 class="editorial-display editorial-section__title editorial-section__title--light">TENTO <span class="editorial-accent--blue">TÝŽDEŇ.</span></h2>
        </div>
        <a href={joinUs.ctaUrl} class="editorial-button editorial-button--ghost">
          {joinUs.ctaText}<span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="editorial-schedule">
        {contact.serviceTimes.map((time: { day: string; time: string }, index: number) => (
          <article class="editorial-schedule__item">
            <span>0{index + 1}</span>
            <strong>{time.time}</strong>
            <h3>{time.day}</h3>
            <p>Spoločné stretnutie v New Level Church</p>
          </article>
        ))}
        <article class="editorial-schedule__item editorial-schedule__item--address">
          <span>03</span>
          <strong>SNV</strong>
          <h3>{contact.address}</h3>
          <p>{contact.city}</p>
        </article>
      </div>

      <div class="editorial-visit__footer">
        <p>{joinUs.subtitle}</p>
        <figure class="editorial-visit__photo">
          <picture>
            <source srcset={joinUs.imageWebp} type="image/webp" />
            <img src={joinUs.image} alt={joinUs.imageAlt} loading="lazy" width="1200" height="800" />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  <script is:inline>
    const heroSection = document.querySelector('[data-hero-backgrounds]');
    const currentBackground = heroSection?.querySelector('[data-hero-bg-current]');
    const nextBackground = heroSection?.querySelector('[data-hero-bg-next]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function shuffleImages(images) {
      const shuffled = [...images];

      for (let i = shuffled.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }

      return shuffled;
    }

    function applyBackground(image, background) {
      image.style.setProperty('--hero-position', background.desktopPosition);
      image.style.setProperty('--hero-mobile-position', background.mobilePosition);
    }

    if (heroSection && currentBackground && nextBackground) {
      const backgrounds = JSON.parse(heroSection.dataset.heroBackgrounds ?? '[]');

      if (backgrounds.length > 1) {
        let activeImage = backgrounds[0];
        let queue = shuffleImages(backgrounds.slice(1));

        window.setInterval(() => {
          if (queue.length === 0) {
            queue = shuffleImages(backgrounds.filter(({ image }) => image !== activeImage.image));
          }

          const upcomingImage = queue.shift();

          if (!upcomingImage) {
            return;
          }

          nextBackground.onload = () => {
            nextBackground.onload = null;

            if (prefersReducedMotion) {
              currentBackground.src = upcomingImage.image;
              applyBackground(currentBackground, upcomingImage);
              activeImage = upcomingImage;
              return;
            }

            nextBackground.classList.remove('is-next');
            nextBackground.classList.add('is-current');
            currentBackground.classList.remove('is-current');
            currentBackground.classList.add('is-next');

            window.setTimeout(() => {
              currentBackground.src = upcomingImage.image;
              applyBackground(currentBackground, upcomingImage);
              currentBackground.classList.remove('is-next');
              currentBackground.classList.add('is-current');
              nextBackground.classList.remove('is-current');
              nextBackground.classList.add('is-next');
              activeImage = upcomingImage;
            }, 1000);
          };
          applyBackground(nextBackground, upcomingImage);
          nextBackground.src = upcomingImage.image;

          if (nextBackground.complete) {
            nextBackground.onload?.(new Event('load'));
          }
        }, 7000);
      }
    }
  </script>
</BaseLayout>
