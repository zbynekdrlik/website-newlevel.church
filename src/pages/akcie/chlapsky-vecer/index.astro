---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import upcomingEvents from '../../../content/homepage/upcoming-events.json';

const event = upcomingEvents.events.find((item) =>
  item.slug === 'chlapsky-vecer-2026-11-20'
);
if (!event) throw new Error('Chlapský večer is missing from upcoming-events.json');

const date = new Intl.DateTimeFormat('sk-SK', {
  timeZone: 'UTC',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(event.date + 'T12:00:00Z'));
const dateLabel = date.charAt(0).toUpperCase() + date.slice(1);
---

<BaseLayout title="Prihláška na Chlapský večer | New Level Church" description="Prihláška na Chlapský večer SNV, 20. novembra 2026 o 18:00 v New Level Church." currentPage="akcie">
  <div class="event-page">
    <div class="event-page__shell">
      <a class="event-page__back" href="/#akcie">← Späť na akcie</a>

      <div class="event-page__layout">
        <div>
          <p class="event-page__kicker">// NEW LEVEL CHURCH · SPIŠSKÁ NOVÁ VES</p>
          <h1 class="event-page__title">CHLAPSKÝ<br /><span>VEČER.</span><small>SNV</small></h1>
          <p class="event-page__tagline">{event.tagline}</p>
          <p class="event-page__lead">{event.description}</p>
          <p class="event-page__details"><strong>{dateLabel} o {event.time}</strong><br />{event.venue}, {event.address}</p>
          <p class="event-page__deadline">Prihlasovanie sa končí v stredu 18. novembra o 20:00.</p>

          <section class="event-page__registration" id="prihlaska" aria-labelledby="registration-heading">
            <h2 id="registration-heading">PRIHLÁŠKA</h2>
            <p>Vyplň svoje údaje a daj nám vedieť, či chceš jedlo.</p>
            <p class="event-page__feedback" id="event-form-feedback" role="status" tabindex="-1" hidden></p>
            <p class="event-page__closed" id="event-form-closed" hidden>Prihlasovanie na túto akciu je ukončené.</p>

            <form id="event-registration-form" data-event-slug={event.slug} data-registration-closes-at={event.registrationClosesAt}>
              <div class="event-page__field">
                <label for="event-name">Meno</label>
                <input id="event-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required />
              </div>
              <div class="event-page__field">
                <label for="event-phone">Telefón</label>
                <input id="event-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="32" required />
              </div>
              <div class="event-page__field">
                <label for="event-email">Email</label>
                <input id="event-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
              </div>
              <fieldset class="event-page__food">
                <legend>Chceš jedlo?</legend>
                <label><input type="radio" name="wantsFood" value="true" required /> Áno, chcem jedlo</label>
                <label><input type="radio" name="wantsFood" value="false" required /> Nie, bez jedla</label>
              </fieldset>
              <p class="event-page__privacy">Údaje uložíme pre organizáciu akcie a oznámime organizátorom cez Discord, aby vedeli pripraviť tvoju účasť a jedlo.</p>
              <button class="event-page__submit" type="submit">Odoslať prihlášku <span aria-hidden="true">→</span></button>
            </form>
          </section>
        </div>

        <figure class="event-page__poster">
          <img src={event.image} alt={event.imageAlt} width={event.imageWidth} height={event.imageHeight} />
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .event-page { --event-accent: #056ca8; background: #f2eee3; color: #050505; padding: clamp(2rem, 6vw, 5rem) 0 clamp(5rem, 8vw, 8rem); }
  .event-page__shell { width: min(100% - 2rem, 78rem); margin-inline: auto; }
  .event-page__back, .event-page__kicker { font-family: 'Space Mono', monospace; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .event-page__back { display: inline-block; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .event-page__back:hover { color: var(--event-accent); }
  .event-page__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr); align-items: start; gap: clamp(3rem, 8vw, 8rem); }
  .event-page__kicker { margin: 0 0 1.25rem; color: var(--event-accent); }
  .event-page__title { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-size: clamp(4.3rem, 8vw, 8rem); font-weight: 900; letter-spacing: 0; line-height: 1.06; }
  .event-page__title span { color: var(--event-accent); }
  .event-page__title small { display: block; margin-top: 0.8rem; color: #050505; font-family: 'Space Mono', monospace; font-size: 0.85rem; letter-spacing: 0.16em; line-height: 1.5; }
  .event-page__tagline { margin: 1.7rem 0 0.45rem; font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 700; line-height: 1.4; }
  .event-page__lead { max-width: 34rem; margin: 0; font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.55; }
  .event-page__details { margin: 1.3rem 0 0; font-family: 'Space Mono', monospace; font-size: 0.8rem; line-height: 1.8; }
  .event-page__details strong { color: var(--event-accent); }
  .event-page__deadline { margin: 1rem 0 0; font-weight: 700; }
  .event-page__registration { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; border-top: 2px solid #050505; scroll-margin-top: 7rem; }
  .event-page__registration h2 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 900; line-height: 1; }
  .event-page__registration > p:not(.event-page__feedback):not(.event-page__closed) { margin: 0.7rem 0 2rem; color: #404040; }
  .event-page__field { margin-bottom: 1.35rem; }
  .event-page__field label, .event-page__food legend { display: block; margin-bottom: 0.55rem; font-family: 'Space Mono', monospace; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .event-page__field input { display: block; width: 100%; min-height: 3.25rem; padding: 0.8rem 0.9rem; border: 1px solid #8c8980; border-radius: 0; background: transparent; color: #050505; font-size: 1rem; }
  .event-page__field input:focus-visible { outline: 3px solid var(--event-accent); outline-offset: 2px; border-color: #050505; }
  .event-page__food { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; margin: 1.9rem 0 0; padding: 0; border: 0; }
  .event-page__food legend { margin-bottom: 0.8rem; }
  .event-page__food label { display: inline-flex; align-items: center; gap: 0.6rem; cursor: pointer; }
  .event-page__food input { width: 1.15rem; height: 1.15rem; accent-color: var(--event-accent); }
  .event-page__privacy { max-width: 34rem; margin: 2rem 0 1.2rem; color: #565656; font-size: 0.78rem; line-height: 1.6; }
  .event-page__submit { display: inline-flex; min-height: 3.35rem; align-items: center; justify-content: space-between; gap: 2rem; padding: 0.9rem 1.4rem; border: 0; border-radius: 999px; background: #050505; color: #fff; font-family: 'Space Mono', monospace; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; cursor: pointer; }
  .event-page__submit:hover { background: var(--event-accent); }
  .event-page__submit:focus-visible { outline: 3px solid var(--event-accent); outline-offset: 3px; }
  .event-page__submit:disabled { opacity: 0.55; cursor: wait; }
  .event-page__feedback, .event-page__closed { margin: 1.5rem 0; padding: 1rem 1.2rem; background: #dbeceb; color: #173d3e; line-height: 1.55; }
  .event-page__feedback[data-state="error"] { background: #f7d9d9; color: #760b14; }
  .event-page__feedback[hidden], .event-page__closed[hidden], #event-registration-form[hidden] { display: none; }
  .event-page__poster { width: min(100%, 30rem); margin: 0; justify-self: end; }
  .event-page__poster img { display: block; width: 100%; height: auto; }
  @media (max-width: 800px) {
    .event-page__layout { grid-template-columns: 1fr; }
    .event-page__poster { justify-self: start; width: min(100%, 24rem); }
    .event-page__title { font-size: clamp(4.2rem, 16vw, 6.5rem); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#event-registration-form');
  const feedback = document.querySelector<HTMLElement>('#event-form-feedback');
  const closed = document.querySelector<HTMLElement>('#event-form-closed');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function showFeedback(message: string, state: 'success' | 'error') {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.dataset.state = state;
    feedback.hidden = false;
    feedback.focus();
  }

  if (form && closed && submit) {
    const closesAt = Date.parse(form.dataset.registrationClosesAt ?? '');
    const updateRegistrationAvailability = () => {
      const isClosed = Number.isFinite(closesAt) && Date.now() >= closesAt;
      form.hidden = isClosed;
      closed.hidden = !isClosed;
    };
    updateRegistrationAvailability();
    if (Number.isFinite(closesAt) && closesAt > Date.now()) {
      window.setTimeout(updateRegistrationAvailability, closesAt - Date.now());
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) updateRegistrationAvailability();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      feedback?.setAttribute('hidden', '');
      submit.disabled = true;
      submit.innerHTML = 'Odosielam…';
      const fields = new FormData(form);

      try {
        const response = await fetch('/api/register-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            eventSlug: form.dataset.eventSlug,
            name: fields.get('name'),
            phone: fields.get('phone'),
            email: fields.get('email'),
            wantsFood: fields.get('wantsFood') === 'true',
          }),
        });
        const result = await response.json();
        if (response.ok && result.success) {
          showFeedback('Prihláška je odoslaná. Tešíme sa na teba na Chlapskom večeri!', 'success');
          form.reset();
        } else if (response.status === 410) {
          form.hidden = true;
          closed.hidden = false;
        } else {
          showFeedback('Prihlášku sa nepodarilo odoslať. Skontroluj údaje a skús to znova.', 'error');
        }
      } catch {
        showFeedback('Spojenie sa nepodarilo. Skús odoslať prihlášku znova.', 'error');
      } finally {
        submit.disabled = false;
        submit.innerHTML = 'Odoslať prihlášku <span aria-hidden="true">→</span>';
      }
    });
  }
</script>
