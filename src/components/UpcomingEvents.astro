---
import upcomingEvents from '../content/homepage/upcoming-events.json';
import general from '../content/settings/general.json';

const dateFormatter = new Intl.DateTimeFormat('sk-SK', {
  timeZone: 'UTC',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

function formatEventDate(value: string) {
  const formatted = dateFormatter.format(new Date(value + 'T12:00:00Z'));
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
}
---

<section class="editorial-section editorial-events" id="akcie" aria-labelledby="events-heading" data-upcoming-events>
  <div class="editorial-shell">
    <div class="editorial-events__heading">
      <div>
        <p class="editorial-kicker">// STRETNIME SA</p>
        <h2 class="editorial-display editorial-section__title" id="events-heading">NAJBLIŽŠIE <span>AKCIE.</span></h2>
      </div>
      <p class="editorial-copy">Pozrite sa, čo sa u nás chystá. Radi vás privítame v Spišskej Novej Vsi.</p>
    </div>

    <div class="editorial-events__list" data-event-list>
      {upcomingEvents.events.map((event) => (
        <article class="editorial-event" data-event-date={event.date} data-event-time={event.time} data-registration-closes-at={event.registrationClosesAt}>
          <a class="editorial-event__poster" href={event.image} target="_blank" rel="noopener noreferrer" aria-label={'Zobraziť plagát: ' + event.title}>
            <img src={event.image} alt={event.imageAlt} width={event.imageWidth} height={event.imageHeight} loading="lazy" decoding="async" />
          </a>
          <div class="editorial-event__content">
            <time class="editorial-event__datetime" datetime={event.date + 'T' + event.time}>
              {formatEventDate(event.date)} <span aria-hidden="true">/</span> {event.time}
            </time>
            <h3 class="editorial-display editorial-event__title">{event.title}</h3>
            <p class="editorial-event__tagline">{event.tagline}</p>
            <p class="editorial-event__description">{event.description}</p>
            <p class="editorial-event__venue"><strong>{event.venue}</strong><br />{event.address}<br /><a href={event.url}>Mapa a kontakt ↗</a></p>
            <div class="editorial-event__actions">
              <a class="editorial-button editorial-button--dark" href={event.registrationUrl} data-event-registration>Registrovať sa <span aria-hidden="true">↗</span></a>
              <span class="editorial-event__closed" data-event-registration-closed hidden>Prihlasovanie ukončené</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="editorial-events__empty" data-events-empty hidden>
      Momentálne nemáme zverejnené ďalšie akcie. Novinky nájdete na <a href={general.social.instagram} target="_blank" rel="noopener noreferrer">našom Instagrame</a>.
    </p>
  </div>
</section>

<script>
  const eventsSection = document.querySelector<HTMLElement>('[data-upcoming-events]');
  const eventsList = eventsSection?.querySelector<HTMLElement>('[data-event-list]');
  const emptyState = eventsSection?.querySelector<HTMLElement>('[data-events-empty]');

  function updateUpcomingEvents() {
    if (!eventsList || !emptyState) return;

    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Bratislava',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const part = (type: string) => parts.find((entry) => entry.type === type)?.value ?? '';
    const today = [part('year'), part('month'), part('day')].join('-');

    const events = Array.from(eventsList.querySelectorAll<HTMLElement>('[data-event-date]'))
      .sort((first, second) => {
        const firstStart = [first.dataset.eventDate, first.dataset.eventTime].join('T');
        const secondStart = [second.dataset.eventDate, second.dataset.eventTime].join('T');
        return firstStart.localeCompare(secondStart);
      });

    for (const event of events) {
      event.hidden = (event.dataset.eventDate ?? '') < today;
      const closesAt = Date.parse(event.dataset.registrationClosesAt ?? '');
      const isRegistrationClosed = Number.isFinite(closesAt) && Date.now() >= closesAt;
      const registrationLink = event.querySelector<HTMLElement>('[data-event-registration]');
      const closedLabel = event.querySelector<HTMLElement>('[data-event-registration-closed]');
      if (registrationLink) registrationLink.hidden = isRegistrationClosed;
      if (closedLabel) closedLabel.hidden = !isRegistrationClosed;
      eventsList.append(event);
    }

    emptyState.hidden = events.some((event) => !event.hidden);
  }

  updateUpcomingEvents();
  const nextDeadline = Math.min(...Array.from(eventsList?.querySelectorAll<HTMLElement>('[data-registration-closes-at]') ?? [])
    .map((event) => Date.parse(event.dataset.registrationClosesAt ?? ''))
    .filter((value) => Number.isFinite(value) && value > Date.now()));
  if (Number.isFinite(nextDeadline) && nextDeadline - Date.now() <= 2_147_483_647) {
    window.setTimeout(updateUpcomingEvents, nextDeadline - Date.now());
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) updateUpcomingEvents();
  });
</script>
